model CalendarEvent {
  id              String   @id @default(cuid())
  schoolId        String
  school          School   @relation(fields: [schoolId], references: [id])
  title           String
  description     String?
  startDate       DateTime
  endDate         DateTime
  allDay          Boolean  @default(false)
  location        String?
  eventType       String   @default("OTHER") // HOLIDAY | EXAM | MEETING | OUTING | DEADLINE | OTHER
  targetType      String   @default("ALL") // ALL | DIRECTION | CLASSROOM | STAFF
  classroomId     String?
  status          String   @default("ACTIVE")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([schoolId, startDate])
  @@index([eventType])
}

// ============================================================
// COMPTABILITÉ — MODULE FINANCE (Cycle 02, §3.11 du cahier des charges)
// ============================================================
// Implémente :
//   - le plan comptable configurable (ChartOfAccount) ;
//   - les journaux comptables (AccountingJournal : VE-SCO, VE-SAL, CAIS, BQ, etc.) ;
//   - les écritures en double entrée (JournalEntry + JournalEntryLine) ;
//   - le lien entre factures/paiements et écritures comptables.
//
// Précision monétaire (DEC-005) : tous les montants sont stockés sous forme
// d'entier (centimes) en Int. Aucun Float. Les calculs se fontent côté
// application via src/lib/money.ts (BigInt natif).
// ============================================================

model ChartOfAccount {
  id              String   @id @default(cuid())
  schoolId        String
  school          School   @relation(fields: [schoolId], references: [id])
  accountNumber   String   // ex: 411001, 706100, 530000
  accountLabel    String   // ex: "Clients académiques", "Inscriptions"
  accountClass    String   // 1 à 7 (classe PCG)
  accountCategory String   // TREASURY | CUSTOMER | SUPPLIER | PRODUCT | CHARGE | EQUITY | TAX | OTHER
  accountType     String   // ASSET | LIABILITY | REVENUE | EXPENSE | EQUITY
  direction       String?  // DEBIT | CREDIT — sens de solde normal
  isProductAccount Boolean @default(false)
  isTaxAccount    Boolean  @default(false)
  isTreasuryAccount Boolean @default(false)
  isCustomerAccount Boolean @default(false)
  isSupplierAccount Boolean @default(false)
  status          String   @default("ACTIVE") // ACTIVE | ARCHIVED
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  journalLines    JournalEntryLine[]

  @@unique([schoolId, accountNumber])
  @@index([schoolId, accountCategory])
  @@index([schoolId, accountType])
}

model AccountingJournal {
  id              String   @id @default(cuid())
  schoolId        String
  school          School   @relation(fields: [schoolId], references: [id])
  code            String   // VE-SCO, VE-SAL, VE-VEH, CAIS, BQ, ACHA, PAIE, OD
  label           String   // "Ventes scolaires", "Caisse", etc.
  journalType     String   // SALES | CASH | BANK | PURCHASE | PAYROLL | MISC
  status          String   @default("ACTIVE") // ACTIVE | ARCHIVED
  createdAt       DateTime @default(now())

  entries         JournalEntry[]

  @@unique([schoolId, code])
}

model JournalEntry {
  // Une écriture comptable = une transaction validée en double entrée.
  // Liée à une facture, un paiement, un avoir ou une opération diverse.
  id              String   @id @default(cuid())
  schoolId        String
  school          School   @relation(fields: [schoolId], references: [id])
  entryNumber     String   @unique // numéro séquentiel par journal + période
  journalId       String
  journal         AccountingJournal @relation(fields: [journalId], references: [id])
  entryDate       DateTime
  accountingPeriod String  // "2025-09" (YYYY-MM)
  description     String
  referenceType   String?  // INVOICE | PAYMENT | REFUND | CREDIT_NOTE | MANUAL
  referenceId     String?  // ID de l'Invoice, Payment, etc.
  status          String   @default("POSTED") // DRAFT | POSTED | REVERSED
  totalDebit      Int      // total débit en centimes (doit = totalCredit)
  totalCredit     Int      // total crédit en centimes
  isBalanced      Boolean  @default(false) // calculé à chaque insertion
  reversalOfId    String?  // si c'est une écriture d'inversion, référence à l'originale
  postedAt        DateTime @default(now())
  postedById      String?
  createdAt       DateTime @default(now())

  lines           JournalEntryLine[]

  @@index([schoolId, journalId, entryDate])
  @@index([referenceType, referenceId])
  @@index([accountingPeriod])
  @@index([status])
}

model JournalEntryLine {
  // Une ligne d'écriture. Débit OU crédit, jamais les deux (le cas échéant,
  // on crée deux lignes). Les montants sont en centimes (Int).
  id              String   @id @default(cuid())
  entryId          String
  entry           JournalEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  accountId       String
  account         ChartOfAccount @relation(fields: [accountId], references: [id])
  debit           Int      @default(0) // centimes
  credit          Int      @default(0) // centimes
  description     String?
  // Dimensions analytiques (§3.11.10)
  analyticalActivity String? // ECOLE | LOCATION_SALLE | LOCATION_VEHICULE
  analyticalSite  String?
  analyticalResource String?
  analyticalContract String?
  analyticalPeriod  String?
  analyticalDirection String?
  createdAt       DateTime @default(now())

  @@index([entryId])
  @@index([accountId])
  @@index([analyticalActivity])
}

// Extension des tables existantes pour la liaison comptable
// (sans casser l'existant — relation optionnelle)
// ============================================================
// INDUSTRIALISATION — MODULES ÉTENDUS (Phase 2)
// ============================================================

// A. Recouvrement & Échéanciers
model PaymentSchedule {
  id              String   @id @default(cuid())
  schoolId        String
  invoiceId       String
  installmentNumber Int
  dueDate         DateTime
  amountCents     Int
  paidCents       Int      @default(0)
  status          String   @default("PENDING") // PENDING | PARTIAL | PAID | LATE
  createdAt       DateTime @default(now())

  @@index([invoiceId])
  @@index([status, dueDate])
}

// B. Cahier de textes
model TeacherLogbook {
  id              String   @id @default(cuid())
  schoolId        String
  teacherId       String
  classroomId     String
  classroom       Classroom @relation(fields: [classroomId], references: [id])
  courseId        String?
  sessionDate     DateTime
  content         String
  homework        String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([schoolId, classroomId, sessionDate])
}

// C. Emplois du temps
model Timetable {
  id              String   @id @default(cuid())
  schoolId        String
  classroomId     String
  courseId        String
  dayOfWeek       Int      // 0=Dimanche, 6=Samedi
  startTime       String   // "08:00"
  endTime         String   // "10:00"
  room            String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([schoolId, classroomId, dayOfWeek])
  @@unique([schoolId, classroomId, courseId, dayOfWeek, startTime])
}

// D. Discipline & Suivi disciplinaire
model DisciplineIncident {
  id              String   @id @default(cuid())
  schoolId        String
  studentId       String
  date            DateTime
  type            String   // RETARD | ABSENCE_NON_JUSTIFIEE | SANCTION | OBSERVATION
  severity        String   @default("LOW") // LOW | MEDIUM | HIGH
  description     String
  sanction        String?
  reportedById    String?
  status          String   @default("OPEN") // OPEN | RESOLVED | ARCHIVED
  createdAt       DateTime @default(now())

  @@index([schoolId, studentId, date])
}

// D. Messagerie sécurisée
model MessageThread {
  id              String   @id @default(cuid())
  schoolId        String
  subject         String
  tags            String?  // JSON array: ["ABSENCE", "URGENT", "PEDAGOGIE"]
  status          String   @default("OPEN")
  createdById     String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  messages        Message[]
  participants    ThreadParticipant[]
}

model ThreadParticipant {
  id              String   @id @default(cuid())
  threadId        String
  thread          MessageThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  userId          String
  role            String   // SENDER | RECIPIENT
  readAt          DateTime?

  @@index([threadId])
  @@index([userId])
}

model Message {
  id              String   @id @default(cuid())
  threadId        String
  thread          MessageThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  authorId        String
  authorName      String
  content         String
  readReceipts    String?  // JSON array of userIds who read it
  createdAt       DateTime @default(now())

  @@index([threadId])
}

// D. Rendez-vous Parents-Profs
model ParentMeetingSlot {
  id              String   @id @default(cuid())
  schoolId        String
  teacherId       String
  classroomId     String?
  startTime       DateTime
  endTime         DateTime
  bookedByGuardianId String?
  status          String   @default("AVAILABLE") // AVAILABLE | BOOKED | CANCELLED
  notes           String?
  createdAt       DateTime @default(now())

  @@index([schoolId, teacherId, startTime])
}

// E. Recrutement
model JobOffer {
  id              String   @id @default(cuid())
  schoolId        String
  title           String
  description     String
  requirements    String?
  contractType    String   // CDI | CDD | INTERIM
  status          String   @default("OPEN") // OPEN | CLOSED | FILLED
  closingDate     DateTime?
  createdAt       DateTime @default(now())

  applications    JobApplication[]
}

model JobApplication {
  id              String   @id @default(cuid())
  jobId           String
  job             JobOffer @relation(fields: [jobId], references: [id])
  candidateName   String
  candidateEmail  String
  candidatePhone  String?
  coverLetter     String?
  resumeUrl       String?
  status          String   @default("RECEIVED") // RECEIVED | REVIEWING | INTERVIEW | OFFERED | REJECTED
  createdAt       DateTime @default(now())

  @@index([jobId])
}

// E. Variables de paie
model PayrollVariable {
  id              String   @id @default(cuid())
  schoolId        String
  employeeId      String
  period          String   // "2026-09"
  baseSalaryCents Int
  overtimeCents   Int      @default(0)
  bonusCents      Int      @default(0)
  deductionCents  Int      @default(0)
  netSalaryCents  Int
  status          String   @default("DRAFT") // DRAFT | VALIDATED | PAID
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([schoolId, employeeId, period])
}

// E. Modèles de documents officiels
model DocumentTemplate {
  id              String   @id @default(cuid())
  schoolId        String
  name            String   // "Certificat de scolarité", "Attestation"
  type            String   // CERTIFICATE | ATTESTATION | BULLETIN | TRANSCRIPT
  content         String   // Template HTML avec variables {{studentName}}, {{className}}, etc.
  status          String   @default("ACTIVE")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([schoolId, type])
}


