// SmartShule - Portail web parents/élèves/direction
// Version SQLite via Prisma (développement local)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============================================================
// IDENTITÉ & SÉCURITÉ
// ============================================================

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         String   // PARENT | STUDENT | DIRECTION | ADMIN
  displayName  String
  active       Boolean  @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  guardian        Guardian?
  student         Student?
  auditLogs       AuditLog[]
  notifications   Notification[]
  sessions        Session[]
  authoredMessages RequestMessage[]
  syncDevices     SyncDevice[]
  syncOperations   SyncOperation[]
  idempotencyRecords IdempotencyRecord[]
}

model Session {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token        String   @unique
  expiresAt    DateTime
  ipAddress    String?
  userAgent    String?
  revokedAt    DateTime?
  createdAt    DateTime @default(now())

  @@index([userId])
  @@index([token])
}

// ============================================================
// ÉTABLISSEMENT & STRUCTURE
// ============================================================

model School {
  id              String   @id @default(cuid())
  name            String
  slogan          String?
  logoUrl         String?
  primaryColor    String   @default("#2563EB")
  secondaryColor  String   @default("#0F766E")
  tertiaryColor   String   @default("#F59E0B")
  address         String?
  phone           String?
  email           String?
  currency        String   @default("EUR")
  locale          String   @default("fr-FR")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  directorates    Directorate[]
  academicYears   AcademicYear[]
  students        Student[]
  guardians       Guardian[]
  employees       Employee[]
  subjects        Subject[]
  courses         Course[]
  assignments     Assignment[]
  announcements   Announcement[]
  parentRequests  ParentRequest[]
  invoices        Invoice[]
  payments        Payment[]
  feeDefinitions  FeeDefinition[]
  auditLogs       AuditLog[]
  brandings       Branding[]
  syncDevices     SyncDevice[]
  chartOfAccounts ChartOfAccount[]
  accountingJournals AccountingJournal[]
  journalEntries  JournalEntry[]
  attendanceSessions AttendanceSession[]
  attendances     Attendance[]
  grades          Grade[]
  rentalResources RentalResource[]
  rentalContracts RentalContract[]
  books            Book[]
  bookLoans        BookLoan[]
  transportRoutes  TransportRoute[]
  canteenMenus     CanteenMenu[]
  canteenReservations CanteenReservation[]
  calendarEvents   CalendarEvent[]
  // Étape 1 RDC : Nouvelles relations
  options          Option[]
  studentFinancialStatuses StudentFinancialStatus[]
  instanceConfigs  InstanceConfig[]
  // Étape 2 RDC
  employeeSchedules EmployeeSchedule[]
  employeeAttendances EmployeeAttendance[]
}

model Branding {
  id              String   @id @default(cuid())
  schoolId        String
  school          School   @relation(fields: [schoolId], references: [id])
  version         Int      @default(1)
  status          String   @default("PUBLISHED") // DRAFT | PUBLISHED
  logoUrl         String?
  primaryColor    String   @default("#2563EB")
  secondaryColor  String   @default("#0F766E")
  tertiaryColor   String   @default("#F59E0B")
  schoolName      String?
  slogan          String?
  publishedAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([schoolId, status])
}

model Directorate {
  id           String   @id @default(cuid())
  schoolId     String
  school       School   @relation(fields: [schoolId], references: [id])
  name         String   // "Maternelle", "Primaire", "Secondaire"
  code         String
  createdAt    DateTime @default(now())

  sections     Section[]
  classrooms   Classroom[]
  employees    Employee[]
}

model Section {
  id             String   @id @default(cuid())
  directorateId  String
  directorate    Directorate @relation(fields: [directorateId], references: [id])
  name           String   // "Mathématiques", "Lettres", "Humanités"
  code           String

  classrooms     Classroom[]
  // Étape 1 RDC : Options pour les Humanités
  options        Option[]
}

model AcademicYear {
  id           String   @id @default(cuid())
  schoolId     String
  school       School   @relation(fields: [schoolId], references: [id])
  label        String   // "2025-2026"
  startDate    DateTime
  endDate      DateTime
  active       Boolean  @default(false)
  createdAt    DateTime @default(now())

  enrollments  Enrollment[]
  classrooms   Classroom[]
  invoices     Invoice[]
  feeDefinitions FeeDefinition[]
}

model Classroom {
  id              String   @id @default(cuid())
  directorateId   String
  directorate     Directorate @relation(fields: [directorateId], references: [id])
  sectionId       String?
  section         Section?   @relation(fields: [sectionId], references: [id])
  // Étape 1 RDC : Option pour les Humanités (Coupe-Couture, Scientifique, etc.)
  // Nullable : null pour Maternelle/Primaire qui n'ont pas d'options
  optionId        String?
  option          Option?    @relation(fields: [optionId], references: [id])
  academicYearId  String
  academicYear    AcademicYear @relation(fields: [academicYearId], references: [id])
  name            String   // "CP1", "6ème A"
  capacity        Int      @default(40)
  // Étape 1 RDC : Année académique pour filtrage rapide
  academicYearLabel String? // "2025-2026" (dénormalisé pour requêtes rapides)
  createdAt       DateTime @default(now())

  enrollments     Enrollment[]
  courses         Course[]
  assignments     Assignment[]
  announcements   Announcement[]
  attendanceSessions AttendanceSession[]
  grades          Grade[]
  // Étape 2 RDC
  employeeSchedules EmployeeSchedule[]
  teacherAssignments TeacherAssignment[]
}

model Subject {
  id           String   @id @default(cuid())
  schoolId     String
  school       School   @relation(fields: [schoolId], references: [id])
  name         String
  code         String

  courses      Course[]
  grades       Grade[]
  assignments  Assignment[]
  teacherAssignments TeacherAssignment[]
  // Étape 2 RDC : Horaires du professeur
  schedules    EmployeeSchedule[]
}

// ============================================================
// ÉLÈVES & RESPONSABLES
// ============================================================

model Student {
  id           String   @id @default(cuid())
  schoolId     String
  school       School   @relation(fields: [schoolId], references: [id])
  matricule    String   @unique
  firstName    String
  lastName     String
  birthDate    DateTime?
  gender       String?  // M | F
  photoUrl     String?
  status       String   @default("ACTIVE") // ACTIVE | ARCHIVED | TRANSFERRED
  userId       String?  @unique
  user         User?    @relation(fields: [userId], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  enrollments     Enrollment[]
  attendances     Attendance[]
  grades          Grade[]
  submissions     Submission[]
  reportCards     ReportCard[]
  guardianLinks   GuardianStudentLink[]
  invoices        Invoice[]
  parentRequests  ParentRequest[]
  canteenReservations CanteenReservation[]
  // Étape 1 RDC : Statut financier
  financialStatus StudentFinancialStatus[]
}

model Guardian {
  id           String   @id @default(cuid())
  schoolId     String
  school       School   @relation(fields: [schoolId], references: [id])
  firstName    String
  lastName     String
  phone        String?
  email        String?
  address      String?
  profession   String?
  userId       String?  @unique
  user         User?    @relation(fields: [userId], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  studentLinks    GuardianStudentLink[]
  parentRequests  ParentRequest[]
  canteenReservations CanteenReservation[]
}

model GuardianStudentLink {
  id           String   @id @default(cuid())
  guardianId   String
  guardian     Guardian @relation(fields: [guardianId], references: [id], onDelete: Cascade)
  studentId    String
  student      Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  relationship String   // PERE | MERE | TUTEUR | AUTRE
  isPrimary    Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@unique([guardianId, studentId])
}

model Enrollment {
  id              String   @id @default(cuid())
  studentId       String
  student         Student  @relation(fields: [studentId], references: [id])
  classroomId     String
  classroom       Classroom @relation(fields: [classroomId], references: [id])
  academicYearId  String
  academicYear    AcademicYear @relation(fields: [academicYearId], references: [id])
  status          String   @default("ACTIVE") // ACTIVE | TRANSFERRED | ARCHIVED
  enrolledAt      DateTime @default(now())
  createdAt       DateTime @default(now())
}

// ============================================================
// PERSONNEL & COURS
// ============================================================

model Employee {
  id              String   @id @default(cuid())
  schoolId        String
  school          School   @relation(fields: [schoolId], references: [id])
  directorateId   String?
  directorate     Directorate? @relation(fields: [directorateId], references: [id])
  firstName       String
  lastName        String
  email           String?
  phone           String?
  function        String   // ENSEIGNANT | DIRECTION | SECRETAIRE | COMPTABLE | RH
  status          String   @default("ACTIVE")
  hireDate        DateTime @default(now())
  // Étape 1 RDC : Rôle global et multi-directions
  globalRole       String?  // ENSEIGNANT | OUVRIER | ADMINISTRATIF | DIRECTION
  isMultiDirectorate Boolean @default(false) // Prof qui enseigne dans plusieurs directions
  createdAt       DateTime @default(now())

  teacherAssignments TeacherAssignment[]
  // Étape 2 RDC : Horaires et présences
  schedules    EmployeeSchedule[]
  attendances  EmployeeAttendance[]
}

model TeacherAssignment {
  id           String   @id @default(cuid())
  employeeId   String
  employee     Employee @relation(fields: [employeeId], references: [id])
  subjectId    String
  subject      Subject  @relation(fields: [subjectId], references: [id])
  classroomId  String?
  classroom    Classroom? @relation(fields: [classroomId], references: [id])
  createdAt    DateTime @default(now())
}

model Course {
  id           String   @id @default(cuid())
  schoolId     String
  school       School   @relation(fields: [schoolId], references: [id])
  classroomId  String
  classroom    Classroom @relation(fields: [classroomId], references: [id])
  subjectId    String
  subject      Subject  @relation(fields: [subjectId], references: [id])
  teacherId    String?
  title        String
  description  String?
  status       String   @default("PUBLISHED") // DRAFT | SUBMITTED | PUBLISHED | ARCHIVED
  publishedAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  assignments  Assignment[]
  attendances  Attendance[]
  sessions     CourseSession[]
  attendanceSessions AttendanceSession[]
  // Étape 2 RDC
  employeeSchedules EmployeeSchedule[]
}

model CourseSession {
  id           String   @id @default(cuid())
  courseId     String
  course       Course   @relation(fields: [courseId], references: [id])
  date         DateTime
  startTime    String   // "08:00"
  endTime      String   // "10:00"
  room          String?
  createdAt    DateTime @default(now())

  attendances  Attendance[]
  attendanceSessions AttendanceSession[]
}

// Session d'appel : regroupe l'appel d'une séance par un professeur.
// Verrouillable (status LOCKED) pour empêcher les modifications postérieures.
model AttendanceSession {
  id              String   @id @default(cuid())
  schoolId        String
  school          School   @relation(fields: [schoolId], references: [id])
  courseId        String
  course          Course   @relation(fields: [courseId], references: [id])
  sessionId       String?  // CourseSession sous-jacente (horaire planifié)
  session         CourseSession? @relation(fields: [sessionId], references: [id])
  classroomId     String
  classroom       Classroom @relation(fields: [classroomId], references: [id])
  teacherId       String?
  date            DateTime
  status          String   @default("OPEN") // OPEN | LOCKED | CANCELLED
  lockedAt        DateTime?
  lockedById      String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  attendances     Attendance[]

  @@index([schoolId, courseId, date])
  @@index([classroomId, date])
  @@index([status])
}

model Attendance {
  id           String   @id @default(cuid())
  schoolId     String
  school       School   @relation(fields: [schoolId], references: [id])
  studentId    String
  student      Student  @relation(fields: [studentId], references: [id])
  courseId     String
  course       Course   @relation(fields: [courseId], references: [id])
  sessionId    String?
  session      CourseSession? @relation(fields: [sessionId], references: [id])
  attendanceSessionId String?
  attendanceSession AttendanceSession? @relation(fields: [attendanceSessionId], references: [id])
  date         DateTime
  status       String   // PRESENT | LATE | ABSENT | EXCUSED
  justified    Boolean  @default(false)
  justification String?
  recordedAt   DateTime @default(now())
  recordedById String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Clé logique anti-doublon : un élève ne peut avoir qu'une seule présence
  // par session d'appel (et par école). Conforme au §14.2.14-J.
  @@unique([schoolId, attendanceSessionId, studentId])
  // Clé secondaire pour rétro-compatibilité (avant AttendanceSession)
  @@unique([studentId, courseId, date])

  @@index([schoolId, date])
  @@index([studentId, status])
  @@index([attendanceSessionId])
}

// ============================================================
// ÉVALUATIONS & BULLETINS
// ============================================================

model Grade {
  id              String   @id @default(cuid())
  schoolId        String
  school          School   @relation(fields: [schoolId], references: [id])
  studentId       String
  student         Student  @relation(fields: [studentId], references: [id])
  subjectId       String
  subject         Subject  @relation(fields: [subjectId], references: [id])
  classroomId     String?
  classroom       Classroom? @relation(fields: [classroomId], references: [id])
  teacherId       String?
  title           String   // "Devoir 1", "Examen trimestriel"
  score           Float
  maxScore        Float
  weight          Float    @default(1)
  // Workflow DEC-008 : DRAFT → SUBMITTED → CONTROLLED → PUBLISHED
  // Une fois PUBLISHED, toute correction passe par GradeCorrection (jamais de modification directe).
  status          String   @default("DRAFT") // DRAFT | SUBMITTED | CONTROLLED | PUBLISHED
  teacherComment  String?
  // Métadonnées de workflow
  draftedAt       DateTime @default(now())
  draftedById     String?
  submittedAt     DateTime?
  submittedById   String?
  controlledAt    DateTime?
  controlledById  String?
  publishedAt     DateTime?
  publishedById   String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Précision : score en centimes pour les calculs
  scoreCents      Int      @default(0)
  maxScoreCents   Int      @default(0)
  weightCents     Int      @default(100) // 1.0 = 100
  // Étape 1 RDC : Calcul automatique et période
  isAutoCalculated Boolean @default(false) // Moyenne générée automatiquement
  periodId        String?  // Référence vers période (T1, T2, T3) — dénormalisé pour requêtes rapides

  corrections     GradeCorrection[]

  @@index([schoolId, status])
  @@index([studentId, status])
  @@index([classroomId, status])
  @@index([subjectId])
}

// Table d'audit des corrections de notes post-publication.
// Conforme au §14.2.14-K.2 : une note publiée ne peut être corrigée
// que via un workflow officiel référencé, jamais par modification directe.
model GradeCorrection {
  id              String   @id @default(cuid())
  gradeId         String
  grade           Grade    @relation(fields: [gradeId], references: [id])
  previousScore   Float
  previousScoreCents Int
  correctedScore  Float
  correctedScoreCents Int
  reason          String
  requestedById   String
  approvedById    String?
  approvedAt      DateTime?
  evidenceDocName String?
  status          String   @default("PENDING") // PENDING | APPROVED | REJECTED
  createdAt       DateTime @default(now())

  @@index([gradeId])
  @@index([status])
}

model ReportCard {
  id              String   @id @default(cuid())
  studentId       String
  student         Student  @relation(fields: [studentId], references: [id])
  academicYearId  String
  period          String   // "T1" | "T2" | "T3"
  status          String   @default("DRAFT") // DRAFT | CONTROLLED | PUBLISHED
  publishedAt     DateTime?
  average         Float?
  rank            Int?
  appreciation    String?
  createdAt       DateTime @default(now())
}

// ============================================================
// DEVOIRS & REMISES
// ============================================================

model Assignment {
  id           String   @id @default(cuid())
  schoolId     String
  school       School   @relation(fields: [schoolId], references: [id])
  classroomId  String
  classroom    Classroom @relation(fields: [classroomId], references: [id])
  courseId     String?
  course       Course?  @relation(fields: [courseId], references: [id])
  subjectId    String?
  subject      Subject?  @relation(fields: [subjectId], references: [id])
  title        String
  description  String?
  dueDate      DateTime
  maxScore     Float?
  status       String   @default("PUBLISHED") // DRAFT | SUBMITTED | PUBLISHED | CLOSED
  publishedAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  submissions  Submission[]
}

model Submission {
  id              String   @id @default(cuid())
  assignmentId    String
  assignment      Assignment @relation(fields: [assignmentId], references: [id])
  studentId       String
  student         Student  @relation(fields: [studentId], references: [id])
  content         String?
  fileName        String?
  fileSize        Int?
  status          String   @default("SUBMITTED") // DRAFT | SUBMITTED | GRADED | RETURNED
  score           Float?
  teacherComment  String?
  submittedAt     DateTime @default(now())
  gradedAt        DateTime?
  updatedAt       DateTime @updatedAt

  @@unique([assignmentId, studentId])
}

// ============================================================
// FINANCE
// ============================================================

model FeeDefinition {
  id              String   @id @default(cuid())
  schoolId        String
  school          School   @relation(fields: [schoolId], references: [id])
  academicYearId  String?
  academicYear    AcademicYear? @relation(fields: [academicYearId], references: [id])
  label           String   // "Frais d'inscription", "Scolarité T1"
  amount          Float
  currency        String   @default("EUR")
  appliesTo       String   @default("ALL") // ALL | BY_LEVEL | BY_CLASS
  createdAt       DateTime @default(now())

  invoiceLines    InvoiceLine[]
}

model Invoice {
  id              String   @id @default(cuid())
  schoolId        String
  school          School   @relation(fields: [schoolId], references: [id])
  studentId       String?
  student         Student? @relation(fields: [studentId], references: [id])
  guardianId      String?
  invoiceNumber   String   @unique
  academicYearId  String?
  academicYear    AcademicYear? @relation(fields: [academicYearId], references: [id])
  issueDate       DateTime @default(now())
  dueDate         DateTime?
  status          String   @default("UNPAID") // DRAFT | UNPAID | PARTIALLY_PAID | PAID | CANCELLED
  totalAmount     Float    // montant TTC (centimes stockés en Int ailleurs ; ici Float pour compat lecture)
  paidAmount      Float    @default(0)
  currency        String   @default("EUR")
  // Centimes pour les calculs précis (Cycle 02 — DEC-005)
  totalAmountCents    Int  @default(0)
  paidAmountCents     Int  @default(0)
  // Indique qu'une écriture comptable a été générée pour cette facture
  accountingEntryId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  lines           InvoiceLine[]
  payments        Payment[]
}

model InvoiceLine {
  id              String   @id @default(cuid())
  invoiceId       String
  invoice         Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  feeDefinitionId String?
  feeDefinition   FeeDefinition? @relation(fields: [feeDefinitionId], references: [id])
  description     String
  quantity        Float    @default(1)
  unitPrice       Float
  discount        Float    @default(0)
  taxRate         Float    @default(0)
  total           Float
  // Centimes pour les calculs précis (Cycle 02 — DEC-005)
  quantityCents      Int  @default(100) // 1.00 = 100
  unitPriceCents     Int  @default(0)
  discountCents      Int  @default(0) // en pourcentage centimes (5% = 500)
  taxRateCents       Int  @default(0) // en pourcentage centimes (20% = 2000)
  grossAmountCents   Int  @default(0) // quantité × prix unitaire
  discountAmountCents Int @default(0)
  netAmountCents     Int  @default(0) // brut - remise
  taxAmountCents     Int  @default(0)
  totalAmountCents   Int  @default(0) // net + taxe = TTC
  // Comptes comptables à débiter/créditer pour cette ligne (transitoire — non persisté dans la DB,
  // utilisé par le moteur de génération d'écritures)
  productAccountNumber String?
  taxAccountNumber   String?
  createdAt       DateTime @default(now())
}

model Payment {
  id              String   @id @default(cuid())
  schoolId        String
  school          School   @relation(fields: [schoolId], references: [id])
  invoiceId       String
  invoice         Invoice  @relation(fields: [invoiceId], references: [id])
  receiptNumber   String   @unique
  amount          Float
  method          String   // CASH | BANK | MOBILE_MONEY | CARD
  payerName       String?
  status          String   @default("CONFIRMED") // PENDING | CONFIRMED | CANCELLED
  paidAt          DateTime @default(now())
  cancelledAt     DateTime?
  cancellationReason String?
  // Centimes pour les calculs précis (Cycle 02 — DEC-005)
  amountCents     Int      @default(0)
  // Indique qu'une écriture comptable a été générée pour ce paiement
  accountingEntryId String?
  // Si ce paiement est une régularisation (avoir/remboursement), référence au paiement original
  reversesPaymentId String?
  createdAt       DateTime @default(now())
}

// ============================================================
// LOCATIONS (Cycle 05, §3.13 + §3.14)
// Salles et véhicules avec acomptes, cautions, états des lieux,
// contrats, facturation et comptabilité analytique dédiée.
// ============================================================

model RentalResource {
  // Ressource louable : salle ou véhicule
  id              String   @id @default(cuid())
  schoolId        String
  school          School   @relation(fields: [schoolId], references: [id])
  type            String   // ROOM | VEHICLE
  code            String   // identifiant métier unique par école (ex: SALLE-A, VEH-001)
  name            String
  description     String?
  capacity        Int?     // pour les salles
  // Spécifique véhicules
  brand           String?  // marque
  model           String?  // modèle
  registrationPlate String? // immatriculation
  mileageKm       Int?
  // Tarification
  hourlyRateCents Int      @default(0)
  dailyRateCents  Int      @default(0)
  // État
  status          String   @default("ACTIVE") // ACTIVE | MAINTENANCE | RETIRED
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  rentals         RentalContract[]

  @@unique([schoolId, code])
  @@index([schoolId, type, status])
}

model RentalContract {
  // Contrat de location : salle ou véhicule
  id              String   @id @default(cuid())
  schoolId        String
  school          School   @relation(fields: [schoolId], references: [id])
  contractNumber  String   @unique
  resourceId      String
  resource        RentalResource @relation(fields: [resourceId], references: [id])
  resourceType    String   // ROOM | VEHICLE (dénormalisé pour requêtes faciles)
  // Client
  customerName    String
  customerPhone   String?
  customerEmail   String?
  customerType    String   @default("INDIVIDUAL") // INDIVIDUAL | ORGANIZATION
  // Période
  startDate       DateTime
  endDate         DateTime
  // Montants en centimes
  rentalAmountCents Int
  depositAmountCents Int  @default(0) // acompte
  cautionAmountCents Int @default(0) // caution remboursable
  penaltyAmountCents  Int @default(0) // pénalités éventuelles
  totalAmountCents Int   // total TTC à payer
  paidAmountCents  Int    @default(0)
  // États des lieux
  checkInNotes    String?
  checkInAt       DateTime?
  checkInById      String?
  checkOutNotes   String?
  checkOutAt      DateTime?
  checkOutById     String?
  damageNotes     String?
  damageAmountCents Int  @default(0)
  // Workflow
  status          String   @default("DRAFT")
  // DRAFT → QUOTE (devis) → CONFIRMED (réservation) → ACTIVE (en cours)
  // → COMPLETED (terminé) → INVOICED (facturé) → CLOSED (clôturé)
  // | CANCELLED
  quoteAt         DateTime?
  confirmedAt     DateTime?
  activeAt        DateTime?
  completedAt     DateTime?
  invoicedAt      DateTime?
  closedAt        DateTime?
  cancelledAt     DateTime?
  cancellationReason String?
  // Liaison facture
  invoiceId       String?
  // Audit
  createdById     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([schoolId, status])
  @@index([schoolId, resourceId, startDate, endDate])
  @@index([customerEmail])
}

