  schoolId        String
  school          School   @relation(fields: [schoolId], references: [id])
  bookId          String
  book            Book     @relation(fields: [bookId], references: [id])
  borrowerName    String
  borrowerType    String   @default("STUDENT") // STUDENT | TEACHER | STAFF
  borrowerId      String?
  loanDate       DateTime @default(now())
  dueDate        DateTime
  returnDate      DateTime?
  status          String   @default("ACTIVE") // ACTIVE | RETURNED | OVERDUE | LOST
  notes           String?
  createdAt       DateTime @default(now())

  @@index([schoolId, status])
  @@index([bookId])
}

model TransportRoute {
  id              String   @id @default(cuid())
  schoolId        String
  school          School   @relation(fields: [schoolId], references: [id])
  name            String   // "Ligne Nord", "Ligne Sud"
  code            String
  description     String?
  vehicleId       String?  // lien vers RentalResource (véhicule)
  driverName      String?
  driverPhone     String?
  capacity        Int      @default(30)
  stops           String?  // JSON list of stops
  status          String   @default("ACTIVE")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([schoolId, code])
}

model CanteenMenu {
  id              String   @id @default(cuid())
  schoolId        String
  school          School   @relation(fields: [schoolId], references: [id])
  date            DateTime
  starter         String?
  mainCourse      String
  dessert         String?
  drink           String?
  priceCents      Int      @default(0)
  vegetarianOption String?
  allergens       String?
  status          String   @default("PUBLISHED") // DRAFT | PUBLISHED | CANCELLED
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  reservations    CanteenReservation[]

