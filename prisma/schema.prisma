// ============================================================
// TOPOLOGIE RDC — Étape 1 (Extension modulaire non-cassante)
// ============================================================

// Options spécifiques aux Humanités (Coupe-Couture, Commerciale, etc.)
// Relation : Section (ex: "Humanités") → Option (ex: "Scientifique")
model Option {
  id              String   @id @default(cuid())
  schoolId        String
  school          School   @relation(fields: [schoolId], references: [id])
  sectionId       String
  section         Section  @relation(fields: [sectionId], references: [id])
  name            String   // "Coupe-Couture", "Commerciale & Gestion", "Scientifique"
  code            String   // "CC", "CG", "SCI"
  status          String   @default("ACTIVE")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  classrooms      Classroom[]

  @@unique([schoolId, sectionId, code])
  @@index([schoolId, status])
}

// Statut financier de l'élève (visible par le prof via alerte discrète)
// Le module Comptabilité met à jour ce statut, le Portail Prof le consulte
model StudentFinancialStatus {
  id              String   @id @default(cuid())
  schoolId        String
  school          School   @relation(fields: [schoolId], references: [id])
  studentId       String
  student         Student  @relation(fields: [studentId], references: [id])
  status          String   @default("REGULAR") // REGULAR | LITIGATION | BLOCKED
  reason          String?  // "Frais impayés T1", "Acompte manquant"
  blockedAt       DateTime?
  updatedById     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([schoolId, status])
  @@index([studentId])
  @@unique([schoolId, studentId])
}

// Configuration de l'instance (rôle de la machine)
// Détermine si l'app tourne en mode Serveur, Prof, Comptabilité ou Standard
model InstanceConfig {
  id              String   @id @default(cuid())
  schoolId        String
  school          School   @relation(fields: [schoolId], references: [id])
  deviceId        String?  // Lien optionnel avec SyncDevice existant
  instanceRole    String   // STANDARD | SERVER | TEACHER | ACCOUNTING
  syncTarget      String   @default("LOCAL") // LOCAL (PromoServeur) | CLOUD (Supabase)
  serverIp        String?  // IP locale du PromoServeur (mode LAN)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([schoolId, deviceId])
  @@index([schoolId, instanceRole])
}

// ============================================================
// ÉTAPE 2 RDC — Chaîne académique complète
// ============================================================

// Horaire d'un professeur (planning hebdomadaire)
model EmployeeSchedule {
  id              String   @id @default(cuid())
  schoolId        String
  school          School   @relation(fields: [schoolId], references: [id])
  employeeId      String
  employee        Employee @relation(fields: [employeeId], references: [id])
  classroomId     String?
  classroom       Classroom? @relation(fields: [classroomId], references: [id])
  courseId         String?
  course          Course?  @relation(fields: [courseId], references: [id])
  subjectId       String?
  subject         Subject? @relation(fields: [subjectId], references: [id])
  dayOfWeek       Int      // 0=Dimanche, 6=Samedi
  startTime       String   // "08:00"
  endTime         String   // "10:00"
  room            String?
  academicYearLabel String? // "2025-2026"
  status          String   @default("ACTIVE") // ACTIVE | CANCELLED | REPLACED
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([schoolId, employeeId, dayOfWeek, startTime])
  @@index([schoolId, employeeId, dayOfWeek])
  @@index([classroomId, dayOfWeek])
}

// Présence des professeurs (pointage)
model EmployeeAttendance {
  id              String   @id @default(cuid())
  schoolId        String
  school          School   @relation(fields: [schoolId], references: [id])
  employeeId      String
  employee        Employee @relation(fields: [employeeId], references: [id])
  date            DateTime
  status          String   // PRESENT | LATE | ABSENT | EXCUSED | MISSION
  arrivalTime     String?  // "07:55"
  departureTime   String?  // "16:30"
  notes           String?
  recordedById    String?
  createdAt       DateTime @default(now())

  @@unique([schoolId, employeeId, date])
  @@index([schoolId, date])
  @@index([employeeId])
}
