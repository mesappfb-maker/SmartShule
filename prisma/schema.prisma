model CanteenReservation {
  id              String   @id @default(cuid())
  schoolId        String
  school          School   @relation(fields: [schoolId], references: [id])
  menuId          String
  menu            CanteenMenu @relation(fields: [menuId], references: [id])
  studentId       String?
