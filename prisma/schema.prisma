// SmartShule - Portail web parents/élèves/direction
// Version SQLite via Prisma (développement local)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============================================================
// IDENTITÉ & SÉCURITÉ
// ============================================================

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         String   // PARENT | STUDENT | TEACHER | SECRETARY | ACCOUNTANT | DIRECTION | ADMIN | SERVER
  accountStatus String  @default("ACTIVE") // ACTIVE | CANDIDAT_PARENT | PARENT_VERIFIE | PARENT_SUSPENDU | SUSPENDED
  displayName  String
  phone        String?  // Téléphone/WhatsApp vérifié
  active       Boolean  @default(true)
  lastLoginAt  DateTime?
  loginAttempts Int     @default(0) // Anti force-brute
  lockedUntil  DateTime? // Verrouillage temporaire
  mfaEnabled   Boolean  @default(false) // Double authentification
  mfaSecret    String?  // Secret TOTP
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  guardian        Guardian?
  student         Student?
  auditLogs       AuditLog[]
  notifications   Notification[]
  sessions        Session[]
  authoredMessages RequestMessage[]
  syncDevices     SyncDevice[]
  syncOperations   SyncOperation[]
  idempotencyRecords IdempotencyRecord[]
  preRegistrations PreRegistration[]
  parentLinkRequests ParentLinkRequest[]
  // Étape 9 — Admissions V2
  admissionApplications AdmissionApplication[]
}

model Session {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token        String   @unique
  expiresAt    DateTime
  ipAddress    String?
  userAgent    String?
  revokedAt    DateTime?
  createdAt    DateTime @default(now())

  @@index([userId])
  @@index([token])
}

// ============================================================
// ÉTABLISSEMENT & STRUCTURE
// ============================================================

model School {
  id              String   @id @default(cuid())
  name            String
  slogan          String?
  logoUrl         String?
  primaryColor    String   @default("#2563EB")
  secondaryColor  String   @default("#0F766E")
  tertiaryColor   String   @default("#F59E0B")
  address         String?
  phone           String?
  email           String?
  currency        String   @default("EUR")
  locale          String   @default("fr-FR")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  directorates    Directorate[]
  academicYears   AcademicYear[]
  students        Student[]
  guardians       Guardian[]
  employees       Employee[]
  subjects        Subject[]
  courses         Course[]
  assignments     Assignment[]
  announcements   Announcement[]
  parentRequests  ParentRequest[]
  invoices        Invoice[]
  payments        Payment[]
  feeDefinitions  FeeDefinition[]
  auditLogs       AuditLog[]
  brandings       Branding[]
  syncDevices     SyncDevice[]
  chartOfAccounts ChartOfAccount[]
  accountingJournals AccountingJournal[]
  journalEntries  JournalEntry[]
  attendanceSessions AttendanceSession[]
  attendances     Attendance[]
  grades          Grade[]
  rentalResources RentalResource[]
  rentalContracts RentalContract[]
  books            Book[]
  bookLoans        BookLoan[]
  transportRoutes  TransportRoute[]
  canteenMenus     CanteenMenu[]
  canteenReservations CanteenReservation[]
  calendarEvents   CalendarEvent[]
  // Étape 1 RDC : Nouvelles relations
  options          Option[]
  studentFinancialStatuses StudentFinancialStatus[]
  instanceConfigs  InstanceConfig[]
  // Étape 2 RDC
  employeeSchedules EmployeeSchedule[]
  employeeAttendances EmployeeAttendance[]
  // Étape 3 RDC
  staffAttendanceReports StaffAttendanceReport[]
  invoiceLineConfigs InvoiceLineConfig[]
  encashments   Encashment[]
  evaluationPeriods EvaluationPeriod[]
  digitalReportCards DigitalReportCard[]
  periscolarActivities PeriscolarActivity[]
  periscolarEnrollments PeriscolarEnrollment[]
  // Étape 4 RDC — Portail Prof complet
  teacherAgendas   TeacherAgenda[]
  teacherEmargements TeacherEmargement[]
  studentAttendanceCalls StudentAttendanceCall[]
  lessonLogs       LessonLog[]
  classIncidents   ClassIncident[]
  iqaSnapshots     IqaSnapshot[]
  // Étape 5 RDC — Module comptable sécurisé
  studentDebts     StudentDebt[]
  receipts        Receipt[]
  mobileMoneyPayments MobileMoneyPayment[]
  scholarships    Scholarship[]
  accountingPeriods AccountingPeriod[]
  expenses        Expense[]
  // Étape 6 RDC — Modules contenu & communication
  articles        Article[]
  contacts        Contact[]
  slideshowImages SlideshowImage[]
  receptions      Reception[]
  // Étape 7 — Système de licences
  license         License?
  // Étape 8 — Préinscription & rattachement
  preRegistrations PreRegistration[]
  parentLinkRequests ParentLinkRequest[]
  // Étape 9 — Admissions V2
  admissionApplications AdmissionApplication[]
  // Étape 10 — File d'attente administrative
  adminTasks      AdminTask[]
}

model Branding {
  id              String   @id @default(cuid())
  schoolId        String
  school          School   @relation(fields: [schoolId], references: [id])
  version         Int      @default(1)
  status          String   @default("PUBLISHED") // DRAFT | PUBLISHED
  logoUrl         String?
  primaryColor    String   @default("#2563EB")
  secondaryColor  String   @default("#0F766E")
  tertiaryColor   String   @default("#F59E0B")
  schoolName      String?
  slogan          String?
  publishedAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([schoolId, status])
}

model Directorate {
  id           String   @id @default(cuid())
  schoolId     String
  school       School   @relation(fields: [schoolId], references: [id])
  name         String   // "Maternelle", "Primaire", "Secondaire"
  code         String
  createdAt    DateTime @default(now())

  sections     Section[]
  classrooms   Classroom[]
  employees    Employee[]
  // Étape 3 RDC
  staffAttendanceReports StaffAttendanceReport[]
  invoiceLineConfigs InvoiceLineConfig[]
  // Étape 5 RDC : Module comptable
  studentDebts    StudentDebt[]
  accountingPeriods AccountingPeriod[]
  expenses        Expense[]
}

model Section {
  id             String   @id @default(cuid())
  directorateId  String
  directorate    Directorate @relation(fields: [directorateId], references: [id])
  name           String   // "Mathématiques", "Lettres", "Humanités"
  code           String

  classrooms     Classroom[]
  // Étape 1 RDC : Options pour les Humanités
  options        Option[]
}

model AcademicYear {
  id           String   @id @default(cuid())
  schoolId     String
  school       School   @relation(fields: [schoolId], references: [id])
  label        String   // "2025-2026"
  startDate    DateTime
  endDate      DateTime
  active       Boolean  @default(false)
  createdAt    DateTime @default(now())

  enrollments  Enrollment[]
  classrooms   Classroom[]
  invoices     Invoice[]
  feeDefinitions FeeDefinition[]
  // Étape 5 RDC : Module comptable
  studentDebts StudentDebt[]
}

model Classroom {
  id              String   @id @default(cuid())
  directorateId   String
  directorate     Directorate @relation(fields: [directorateId], references: [id])
  sectionId       String?
  section         Section?   @relation(fields: [sectionId], references: [id])
  // Étape 1 RDC : Option pour les Humanités (Coupe-Couture, Scientifique, etc.)
  // Nullable : null pour Maternelle/Primaire qui n'ont pas d'options
  optionId        String?
  option          Option?    @relation(fields: [optionId], references: [id])
  academicYearId  String
  academicYear    AcademicYear @relation(fields: [academicYearId], references: [id])
  name            String   // "CP1", "6ème A"
  capacity        Int      @default(40)
  // Étape 1 RDC : Année académique pour filtrage rapide
  academicYearLabel String? // "2025-2026" (dénormalisé pour requêtes rapides)
  createdAt       DateTime @default(now())

  enrollments     Enrollment[]
  courses         Course[]
  assignments     Assignment[]
  announcements   Announcement[]
  attendanceSessions AttendanceSession[]
  grades          Grade[]
  // Étape 2 RDC
  employeeSchedules EmployeeSchedule[]
  teacherAssignments TeacherAssignment[]
  // Étape 3 RDC
  digitalReportCards DigitalReportCard[]
  // Cahier de textes
  logbooks         TeacherLogbook[]
  // Étape 4 RDC : Portail Prof complet
  teacherAgendas    TeacherAgenda[]
  teacherEmargements TeacherEmargement[]
  lessonLogs        LessonLog[]
  classIncidents    ClassIncident[]
  iqaSnapshots      IqaSnapshot[]
  // Étape 5 RDC : Module comptable
  studentDebts    StudentDebt[]
}

model Subject {
  id           String   @id @default(cuid())
  schoolId     String
  school       School   @relation(fields: [schoolId], references: [id])
  name         String
  code         String

  courses      Course[]
  grades       Grade[]
  assignments  Assignment[]
  teacherAssignments TeacherAssignment[]
  // Étape 2 RDC : Horaires du professeur
  schedules    EmployeeSchedule[]
  // Étape 4 RDC : Portail Prof complet
  teacherAgendas        TeacherAgenda[]
  teacherEmargements    TeacherEmargement[]
  studentAttendanceCalls StudentAttendanceCall[]
  lessonLogs            LessonLog[]
  iqaSnapshots          IqaSnapshot[]
}

// ============================================================
// ÉLÈVES & RESPONSABLES
// ============================================================

model Student {
  id           String   @id @default(cuid())
  schoolId     String
  school       School   @relation(fields: [schoolId], references: [id])
  matricule    String   @unique
  firstName    String
  lastName     String
  birthDate    DateTime?
  gender       String?  // M | F
  photoUrl     String?
  status       String   @default("ACTIVE") // ACTIVE | ARCHIVED | TRANSFERRED
  userId       String?  @unique
  user         User?    @relation(fields: [userId], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  enrollments     Enrollment[]
  attendances     Attendance[]
  grades          Grade[]
  submissions     Submission[]
  reportCards     ReportCard[]
  guardianLinks   GuardianStudentLink[]
  invoices        Invoice[]
  parentRequests  ParentRequest[]
  canteenReservations CanteenReservation[]
  // Étape 1 RDC : Statut financier
  financialStatus StudentFinancialStatus[]
  // Étape 3 RDC
  encashments     Encashment[]
  digitalReportCards DigitalReportCard[]
  periscolarEnrollments PeriscolarEnrollment[]
  // Étape 4 RDC : Portail Prof complet
  studentAttendanceCalls StudentAttendanceCall[]
  classIncidents   ClassIncident[]
  iqaSnapshots     IqaSnapshot[]
  // Étape 5 RDC : Module comptable
  studentDebts     StudentDebt[]
  receipts        Receipt[]
  // Étape 8 : Demandes de rattachement
  parentLinkRequests ParentLinkRequest[]
  // Étape 10 : File d'attente
  adminTasks      AdminTask[]
}

model Guardian {
  id           String   @id @default(cuid())
  schoolId     String
  school       School   @relation(fields: [schoolId], references: [id])
  firstName    String
  lastName     String
  phone        String?
  email        String?
  address      String?
  profession   String?
  userId       String?  @unique
  user         User?    @relation(fields: [userId], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  studentLinks    GuardianStudentLink[]
  parentRequests  ParentRequest[]
  canteenReservations CanteenReservation[]
  // Étape 3 RDC
  encashments     Encashment[]
}

model GuardianStudentLink {
  id           String   @id @default(cuid())
  guardianId   String
  guardian     Guardian @relation(fields: [guardianId], references: [id], onDelete: Cascade)
  studentId    String
  student      Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  relationship String   // PERE | MERE | TUTEUR | AUTRE
  isPrimary    Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@unique([guardianId, studentId])
}

model Enrollment {
  id              String   @id @default(cuid())
  studentId       String
  student         Student  @relation(fields: [studentId], references: [id])
  classroomId     String
  classroom       Classroom @relation(fields: [classroomId], references: [id])
  academicYearId  String
  academicYear    AcademicYear @relation(fields: [academicYearId], references: [id])
  status          String   @default("ACTIVE") // ACTIVE | TRANSFERRED | ARCHIVED
  enrolledAt      DateTime @default(now())
  createdAt       DateTime @default(now())
  // Étape 5 RDC : Module comptable
  studentDebts    StudentDebt[]
}

// ============================================================
// PERSONNEL & COURS
// ============================================================

model Employee {
  id              String   @id @default(cuid())
  schoolId        String
  school          School   @relation(fields: [schoolId], references: [id])
  directorateId   String?
  directorate     Directorate? @relation(fields: [directorateId], references: [id])
  firstName       String
  lastName        String
  email           String?
  phone           String?
  function        String   // ENSEIGNANT | DIRECTION | SECRETAIRE | COMPTABLE | RH
  status          String   @default("ACTIVE")
  hireDate        DateTime @default(now())
  // Étape 1 RDC : Rôle global et multi-directions
  globalRole       String?  // ENSEIGNANT | OUVRIER | ADMINISTRATIF | DIRECTION
  isMultiDirectorate Boolean @default(false) // Prof qui enseigne dans plusieurs directions
  createdAt       DateTime @default(now())

  teacherAssignments TeacherAssignment[]
  // Étape 2 RDC : Horaires et présences
  schedules    EmployeeSchedule[]
  attendances  EmployeeAttendance[]
  // Relation inverse : cours enseignés
  courses      Course[]
  // Étape 4 RDC : Portail Prof complet
  teacherAgendas       TeacherAgenda[]
  teacherEmargements   TeacherEmargement[]
  lessonLogsAsTeacher  LessonLog[]
  incidentsReported    ClassIncident[]
  incidentsResolved    ClassIncident[] @relation("IncidentResolver")
  // Étape 5 RDC : Module comptable — reçu émis par ce comptable
  receiptsIssued       Receipt[]
}

model TeacherAssignment {
  id           String   @id @default(cuid())
  employeeId   String
  employee     Employee @relation(fields: [employeeId], references: [id])
  subjectId    String
  subject      Subject  @relation(fields: [subjectId], references: [id])
  classroomId  String?
  classroom    Classroom? @relation(fields: [classroomId], references: [id])
  createdAt    DateTime @default(now())
}

model Course {
  id           String   @id @default(cuid())
  schoolId     String
  school       School   @relation(fields: [schoolId], references: [id])
  classroomId  String
  classroom    Classroom @relation(fields: [classroomId], references: [id])
  subjectId    String
  subject      Subject  @relation(fields: [subjectId], references: [id])
  teacherId    String?
  teacher      Employee? @relation(fields: [teacherId], references: [id])
  title        String
  description  String?
  status       String   @default("PUBLISHED") // DRAFT | SUBMITTED | PUBLISHED | ARCHIVED
  publishedAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  assignments  Assignment[]
  attendances  Attendance[]
  sessions     CourseSession[]
  attendanceSessions AttendanceSession[]
  // Étape 2 RDC
  employeeSchedules EmployeeSchedule[]
  // Étape 4 RDC : Portail Prof complet
  teacherAgendas TeacherAgenda[]
}

model CourseSession {
  id           String   @id @default(cuid())
  courseId     String
  course       Course   @relation(fields: [courseId], references: [id])
  date         DateTime
  startTime    String   // "08:00"
  endTime      String   // "10:00"
  room          String?
  createdAt    DateTime @default(now())

  attendances  Attendance[]
  attendanceSessions AttendanceSession[]
}

// Session d'appel : regroupe l'appel d'une séance par un professeur.
// Verrouillable (status LOCKED) pour empêcher les modifications postérieures.
model AttendanceSession {
  id              String   @id @default(cuid())
  schoolId        String
  school          School   @relation(fields: [schoolId], references: [id])
  courseId        String
  course          Course   @relation(fields: [courseId], references: [id])
  sessionId       String?  // CourseSession sous-jacente (horaire planifié)
  session         CourseSession? @relation(fields: [sessionId], references: [id])
  classroomId     String
  classroom       Classroom @relation(fields: [classroomId], references: [id])
  teacherId       String?
  date            DateTime
  status          String   @default("OPEN") // OPEN | LOCKED | CANCELLED
  lockedAt        DateTime?
  lockedById      String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  attendances     Attendance[]

  @@index([schoolId, courseId, date])
  @@index([classroomId, date])
  @@index([status])
}

model Attendance {
  id           String   @id @default(cuid())
  schoolId     String
  school       School   @relation(fields: [schoolId], references: [id])
  studentId    String
  student      Student  @relation(fields: [studentId], references: [id])
  courseId     String
  course       Course   @relation(fields: [courseId], references: [id])
  sessionId    String?
  session      CourseSession? @relation(fields: [sessionId], references: [id])
  attendanceSessionId String?
  attendanceSession AttendanceSession? @relation(fields: [attendanceSessionId], references: [id])
  date         DateTime
  status       String   // PRESENT | LATE | ABSENT | EXCUSED
  justified    Boolean  @default(false)
  justification String?
  recordedAt   DateTime @default(now())
  recordedById String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Clé logique anti-doublon : un élève ne peut avoir qu'une seule présence
  // par session d'appel (et par école). Conforme au §14.2.14-J.
  @@unique([schoolId, attendanceSessionId, studentId])
  // Clé secondaire pour rétro-compatibilité (avant AttendanceSession)
  @@unique([studentId, courseId, date])

  @@index([schoolId, date])
  @@index([studentId, status])
  @@index([attendanceSessionId])
}

// ============================================================
// ÉVALUATIONS & BULLETINS
// ============================================================

model Grade {
  id              String   @id @default(cuid())
  schoolId        String
  school          School   @relation(fields: [schoolId], references: [id])
  studentId       String
  student         Student  @relation(fields: [studentId], references: [id])
  subjectId       String
  subject         Subject  @relation(fields: [subjectId], references: [id])
  classroomId     String?
  classroom       Classroom? @relation(fields: [classroomId], references: [id])
  teacherId       String?
  title           String   // "Devoir 1", "Examen trimestriel"
  score           Float
  maxScore        Float
  weight          Float    @default(1)
  // Workflow DEC-008 : DRAFT → SUBMITTED → CONTROLLED → PUBLISHED
  // Une fois PUBLISHED, toute correction passe par GradeCorrection (jamais de modification directe).
  status          String   @default("DRAFT") // DRAFT | SUBMITTED | CONTROLLED | PUBLISHED
  teacherComment  String?
  // Métadonnées de workflow
  draftedAt       DateTime @default(now())
  draftedById     String?
  submittedAt     DateTime?
  submittedById   String?
  controlledAt    DateTime?
  controlledById  String?
  publishedAt     DateTime?
  publishedById   String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Précision : score en centimes pour les calculs
  scoreCents      Int      @default(0)
  maxScoreCents   Int      @default(0)
  weightCents     Int      @default(100) // 1.0 = 100
  // Étape 1 RDC : Calcul automatique et période
  isAutoCalculated Boolean @default(false) // Moyenne générée automatiquement
  periodId        String?  // Référence vers période (T1, T2, T3) — dénormalisé pour requêtes rapides

  corrections     GradeCorrection[]

  @@index([schoolId, status])
  @@index([studentId, status])
  @@index([classroomId, status])
  @@index([subjectId])
}

// Table d'audit des corrections de notes post-publication.
// Conforme au §14.2.14-K.2 : une note publiée ne peut être corrigée
// que via un workflow officiel référencé, jamais par modification directe.
model GradeCorrection {
  id              String   @id @default(cuid())
  gradeId         String
  grade           Grade    @relation(fields: [gradeId], references: [id])
  previousScore   Float
  previousScoreCents Int
  correctedScore  Float
  correctedScoreCents Int
  reason          String
  requestedById   String
  approvedById    String?
  approvedAt      DateTime?
  evidenceDocName String?
  status          String   @default("PENDING") // PENDING | APPROVED | REJECTED
  createdAt       DateTime @default(now())

  @@index([gradeId])
  @@index([status])
}

model ReportCard {
  id              String   @id @default(cuid())
  studentId       String
  student         Student  @relation(fields: [studentId], references: [id])
  academicYearId  String
  period          String   // "T1" | "T2" | "T3"
  status          String   @default("DRAFT") // DRAFT | CONTROLLED | PUBLISHED
  publishedAt     DateTime?
  average         Float?
  rank            Int?
  appreciation    String?
  createdAt       DateTime @default(now())
}

// ============================================================
// DEVOIRS & REMISES
// ============================================================

model Assignment {
  id           String   @id @default(cuid())
  schoolId     String
  school       School   @relation(fields: [schoolId], references: [id])
  classroomId  String
  classroom    Classroom @relation(fields: [classroomId], references: [id])
  courseId     String?
  course       Course?  @relation(fields: [courseId], references: [id])
  subjectId    String?
  subject      Subject?  @relation(fields: [subjectId], references: [id])
  title        String
  description  String?
  dueDate      DateTime
  maxScore     Float?
  status       String   @default("PUBLISHED") // DRAFT | SUBMITTED | PUBLISHED | CLOSED
  publishedAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  submissions  Submission[]
}

model Submission {
  id              String   @id @default(cuid())
  assignmentId    String
  assignment      Assignment @relation(fields: [assignmentId], references: [id])
  studentId       String
  student         Student  @relation(fields: [studentId], references: [id])
  content         String?
  fileName        String?
  fileSize        Int?
  status          String   @default("SUBMITTED") // DRAFT | SUBMITTED | GRADED | RETURNED
  score           Float?
  teacherComment  String?
  submittedAt     DateTime @default(now())
  gradedAt        DateTime?
  updatedAt       DateTime @updatedAt

  @@unique([assignmentId, studentId])
}

// ============================================================
// FINANCE
// ============================================================

model FeeDefinition {
  id              String   @id @default(cuid())
  schoolId        String
  school          School   @relation(fields: [schoolId], references: [id])
  academicYearId  String?
  academicYear    AcademicYear? @relation(fields: [academicYearId], references: [id])
  label           String   // "Frais d'inscription", "Scolarité T1"
  amount          Float
  currency        String   @default("EUR")
  appliesTo       String   @default("ALL") // ALL | BY_LEVEL | BY_CLASS
  createdAt       DateTime @default(now())

  invoiceLines    InvoiceLine[]
}

model Invoice {
  id              String   @id @default(cuid())
  schoolId        String
  school          School   @relation(fields: [schoolId], references: [id])
  studentId       String?
  student         Student? @relation(fields: [studentId], references: [id])
  guardianId      String?
  invoiceNumber   String   @unique
  academicYearId  String?
  academicYear    AcademicYear? @relation(fields: [academicYearId], references: [id])
  issueDate       DateTime @default(now())
  dueDate         DateTime?
  status          String   @default("UNPAID") // DRAFT | UNPAID | PARTIALLY_PAID | PAID | CANCELLED
  totalAmount     Float    // montant TTC (centimes stockés en Int ailleurs ; ici Float pour compat lecture)
  paidAmount      Float    @default(0)
  currency        String   @default("EUR")
  // Centimes pour les calculs précis (Cycle 02 — DEC-005)
  totalAmountCents    Int  @default(0)
  paidAmountCents     Int  @default(0)
  // Indique qu'une écriture comptable a été générée pour cette facture
  accountingEntryId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  lines           InvoiceLine[]
  payments        Payment[]
}

model InvoiceLine {
  id              String   @id @default(cuid())
  invoiceId       String
  invoice         Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  feeDefinitionId String?
  feeDefinition   FeeDefinition? @relation(fields: [feeDefinitionId], references: [id])
  description     String
  quantity        Float    @default(1)
  unitPrice       Float
  discount        Float    @default(0)
  taxRate         Float    @default(0)
  total           Float
  // Centimes pour les calculs précis (Cycle 02 — DEC-005)
  quantityCents      Int  @default(100) // 1.00 = 100
  unitPriceCents     Int  @default(0)
  discountCents      Int  @default(0) // en pourcentage centimes (5% = 500)
  taxRateCents       Int  @default(0) // en pourcentage centimes (20% = 2000)
  grossAmountCents   Int  @default(0) // quantité × prix unitaire
  discountAmountCents Int @default(0)
  netAmountCents     Int  @default(0) // brut - remise
  taxAmountCents     Int  @default(0)
  totalAmountCents   Int  @default(0) // net + taxe = TTC
  // Comptes comptables à débiter/créditer pour cette ligne (transitoire — non persisté dans la DB,
  // utilisé par le moteur de génération d'écritures)
  productAccountNumber String?
  taxAccountNumber   String?
  createdAt       DateTime @default(now())
}

model Payment {
  id              String   @id @default(cuid())
  schoolId        String
  school          School   @relation(fields: [schoolId], references: [id])
  invoiceId       String
  invoice         Invoice  @relation(fields: [invoiceId], references: [id])
  receiptNumber   String   @unique
  amount          Float
  method          String   // CASH | BANK | MOBILE_MONEY | CARD
  payerName       String?
  status          String   @default("CONFIRMED") // PENDING | CONFIRMED | CANCELLED
  paidAt          DateTime @default(now())
  cancelledAt     DateTime?
  cancellationReason String?
  // Centimes pour les calculs précis (Cycle 02 — DEC-005)
  amountCents     Int      @default(0)
  // Indique qu'une écriture comptable a été générée pour ce paiement
  accountingEntryId String?
  // Si ce paiement est une régularisation (avoir/remboursement), référence au paiement original
  reversesPaymentId String?
  createdAt       DateTime @default(now())
}

// ============================================================
// LOCATIONS (Cycle 05, §3.13 + §3.14)
// Salles et véhicules avec acomptes, cautions, états des lieux,
// contrats, facturation et comptabilité analytique dédiée.
// ============================================================

model RentalResource {
  // Ressource louable : salle ou véhicule
  id              String   @id @default(cuid())
  schoolId        String
  school          School   @relation(fields: [schoolId], references: [id])
  type            String   // ROOM | VEHICLE
  code            String   // identifiant métier unique par école (ex: SALLE-A, VEH-001)
  name            String
  description     String?
  capacity        Int?     // pour les salles
  // Spécifique véhicules
  brand           String?  // marque
  model           String?  // modèle
  registrationPlate String? // immatriculation
  mileageKm       Int?
  // Tarification
  hourlyRateCents Int      @default(0)
  dailyRateCents  Int      @default(0)
  // État
  status          String   @default("ACTIVE") // ACTIVE | MAINTENANCE | RETIRED
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  rentals         RentalContract[]

  @@unique([schoolId, code])
  @@index([schoolId, type, status])
}

model RentalContract {
  // Contrat de location : salle ou véhicule
  id              String   @id @default(cuid())
  schoolId        String
  school          School   @relation(fields: [schoolId], references: [id])
  contractNumber  String   @unique
  resourceId      String
  resource        RentalResource @relation(fields: [resourceId], references: [id])
  resourceType    String   // ROOM | VEHICLE (dénormalisé pour requêtes faciles)
  // Client
  customerName    String
  customerPhone   String?
  customerEmail   String?
  customerType    String   @default("INDIVIDUAL") // INDIVIDUAL | ORGANIZATION
  // Période
  startDate       DateTime
  endDate         DateTime
  // Montants en centimes
  rentalAmountCents Int
  depositAmountCents Int  @default(0) // acompte
  cautionAmountCents Int @default(0) // caution remboursable
  penaltyAmountCents  Int @default(0) // pénalités éventuelles
  totalAmountCents Int   // total TTC à payer
  paidAmountCents  Int    @default(0)
  // États des lieux
  checkInNotes    String?
  checkInAt       DateTime?
  checkInById      String?
  checkOutNotes   String?
  checkOutAt      DateTime?
  checkOutById     String?
  damageNotes     String?
  damageAmountCents Int  @default(0)
  // Workflow
  status          String   @default("DRAFT")
  // DRAFT → QUOTE (devis) → CONFIRMED (réservation) → ACTIVE (en cours)
  // → COMPLETED (terminé) → INVOICED (facturé) → CLOSED (clôturé)
  // | CANCELLED
  quoteAt         DateTime?
  confirmedAt     DateTime?
  activeAt        DateTime?
  completedAt     DateTime?
  invoicedAt      DateTime?
  closedAt        DateTime?
  cancelledAt     DateTime?
  cancellationReason String?
  // Liaison facture
  invoiceId       String?
  // Audit
  createdById     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([schoolId, status])
  @@index([schoolId, resourceId, startDate, endDate])
  @@index([customerEmail])
}

// ============================================================
// PORTAIL — ANNONCES, DEMANDES, NOTIFICATIONS
// ============================================================

model Announcement {
  id              String   @id @default(cuid())
  schoolId        String
  school          School   @relation(fields: [schoolId], references: [id])
  classroomId     String?
  classroom       Classroom? @relation(fields: [classroomId], references: [id])
  title           String
  content         String
  targetType      String   @default("ALL") // ALL | DIRECTION | CLASSROOM
  status          String   @default("PUBLISHED") // DRAFT | PUBLISHED | ARCHIVED
  priority        String   @default("NORMAL") // LOW | NORMAL | HIGH | URGENT
  publishedAt     DateTime?
  expiresAt       DateTime?
  authorId        String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model ParentRequest {
  id              String   @id @default(cuid())
  schoolId        String
  school          School   @relation(fields: [schoolId], references: [id])
  requestNumber   String   @unique
  guardianId      String
  guardian        Guardian @relation(fields: [guardianId], references: [id])
  studentId       String?
  student         Student? @relation(fields: [studentId], references: [id])
  category        String   // INSCRIPTION | FRAIS | ABSENCE | DOCUMENT | TRANSPORT | DISCIPLINE | SANTE | TECHNIQUE | AUTRE
  priority        String   @default("NORMAL") // LOW | NORMAL | HIGH | URGENT
  subject         String
  status          String   @default("NEW") // NEW | IN_PROGRESS | WAITING | ANSWERED | CLOSED | ARCHIVED
  assignedToId    String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  closedAt        DateTime?

  messages        RequestMessage[]
}

model RequestMessage {
  id              String   @id @default(cuid())
  requestId       String
  request         ParentRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  authorId        String
  author          User     @relation(fields: [authorId], references: [id])
  authorName      String
  authorRole      String   // PARENT | DIRECTION | SECRETAIRE
  content         String
  isInternal      Boolean  @default(false)
  attachmentName  String?
  attachmentSize  Int?
  createdAt       DateTime @default(now())
}

model Notification {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type            String   // ANNOUNCEMENT | REQUEST_REPLY | GRADE_PUBLISHED | FEE_DUE | PAYMENT_CONFIRMED
  title           String
  message         String
  link            String?
  read            Boolean  @default(false)
  createdAt       DateTime @default(now())

  @@index([userId, read])
}

// ============================================================
// AUDIT
// ============================================================

model AuditLog {
  id              String   @id @default(cuid())
  schoolId        String?
  school          School?  @relation(fields: [schoolId], references: [id])
  userId          String?
  user            User?    @relation(fields: [userId], references: [id])
  userName        String?
  userRole        String?
  action          String   // LOGIN | LOGOUT | READ | CREATE | UPDATE | DELETE | PUBLISH | etc.
  entityType      String   // STUDENT | INVOICE | PAYMENT | ANNOUNCEMENT | REQUEST | etc.
  entityId        String?
  description     String
  ipAddress       String?
  metadata        String?  // JSON string
  createdAt       DateTime @default(now())

  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
}

// ============================================================
// SYNCHRONISATION — INFRASTRUCTURE TECHNIQUE P0
// Modélise l'architecture hub-and-spoke du cahier des charges §14.2.15.
// Note : dans l'environnement Next.js, le mode hors-ligne réel n'est pas
// implémenté (pas de SQLite par poste navigateur). Ces tables constituent
// l'infrastructure technique prête à servir de contrat pour un futur client
// desktop C#/.NET 8, et sont déjà utilisées pour l'idempotence des commandes.
// ============================================================

model SyncDevice {
  id              String    @id @default(cuid())
  deviceId        String    @unique // identifiant global d'installation (GUID)
  schoolId        String?
  school          School?   @relation(fields: [schoolId], references: [id])
  userId          String?
  user            User?     @relation(fields: [userId], references: [id])
  deviceType      String    // DESKTOP | WEB | MOBILE
  appVersion      String?
  schemaVersion   Int       @default(1)
  publicKeyHint   String?   // empreinte de clé (jamais la clé elle-même)
  lastSeenAtUtc   DateTime?
  revokedAtUtc    DateTime?
  status          String    @default("ACTIVE") // ACTIVE | REVOKED | OBSOLETE
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  operations      SyncOperation[]
  outboxItems     SyncOutbox[]
  conflicts       SyncConflict[]
  inboxItems      SyncInbox[]

  @@index([userId])
  @@index([schoolId])
  @@index([status])
}

model SyncOperation {
  id              String   @id @default(cuid())
  operationId     String   @unique // identifiant global d'opération (GUID) — idempotence
  deviceId        String?
  device          SyncDevice? @relation(fields: [deviceId], references: [id])
  userId          String?
  user            User?     @relation(fields: [userId], references: [id])
  aggregateType   String   // STUDENT | INVOICE | PAYMENT | ANNOUNCEMENT | etc.
  aggregateId     String?
  operationType   String   // CREATE | UPDATE | DELETE | SUBMIT | PUBLISH
  payloadHash     String   // empreinte SHA-256 du payload JSON
  payloadJson     String   // payload versionné (intention métier)
  baseVersion     Int?     // version connue au moment de l'édition (concurrence optimiste)
  receivedAtUtc   DateTime @default(now())
  processedAtUtc  DateTime?
  status          String   @default("PENDING") // PENDING | SENDING | ACCEPTED | REJECTED | CONFLICT | RETRYING | CANCELLED
  resultJson      String?  // résultat sérialisé (réponse à renvoyer au client)
  errorCode       String?
  errorMessage    String?
  conflictId      String?  // référence à SyncConflict si CONFLICT
  attemptCount    Int      @default(0)
  lastAttemptAtUtc DateTime?

  @@index([deviceId])
  @@index([userId])
  @@index([status])
  @@index([aggregateType, aggregateId])
  @@index([receivedAtUtc])
}

model SyncOutbox {
  // File d'envoi locale (concept). En Next.js, utilisée pour tracer les
  // opérations en attente de propagation à un éventuel client desktop.
  id              String   @id @default(cuid())
  operationId     String   @unique
  deviceId        String?
  device          SyncDevice? @relation(fields: [deviceId], references: [id])
  aggregateType   String
  aggregateId     String?
  operationType   String
  payloadJson     String
  payloadHash     String
  baseVersion     Int?
  userId          String?
  createdAtUtc    DateTime @default(now())
  status          String   @default("PENDING") // PENDING | SENDING | ACCEPTED | REJECTED | CONFLICT | RETRYING
  attemptCount    Int      @default(0)
  lastAttemptAtUtc DateTime?
  lastErrorCode   String?
  lastErrorMessage String?

  @@index([deviceId])
  @@index([status, createdAtUtc])
  @@index([aggregateType, aggregateId])
}

model SyncInbox {
  // Changements reçus du serveur à appliquer sur un poste local.
  // En Next.js, surtout utilisée comme audit de propagation.
  id              String   @id @default(cuid())
  changeId        String   @unique // identifiant global de changement
  deviceId        String?
  device          SyncDevice? @relation(fields: [deviceId], references: [id])
  serverSequence  Int      // séquence centrale monotone
  aggregateType   String
  aggregateId     String?
  changeType      String   // CREATE | UPDATE | DELETE
  payloadJson     String
  receivedAtUtc   DateTime @default(now())
  appliedAtUtc    DateTime?
  status          String   @default("PENDING") // PENDING | APPLIED | REJECTED | SKIPPED

  @@index([deviceId])
  @@index([status, serverSequence])
  @@index([aggregateType, aggregateId])
}

model SyncConflict {
  id              String   @id @default(cuid())
  conflictId      String   @unique
  operationId     String?
  deviceId        String?
  device          SyncDevice? @relation(fields: [deviceId], references: [id])
  aggregateType   String
  aggregateId     String?
  localPayloadJson String
  serverPayloadJson String?
  baseVersion     Int?
  serverVersion   Int?
  conflictType    String   // STALE_VERSION | CONTRADICTORY | PERMISSION_REVOKED | BUSINESS_RULE
  assignedToId   String?
  status          String   @default("OPEN") // OPEN | UNDER_REVIEW | RESOLVED | REJECTED
  resolutionStrategy String? // AUTO_DEDUPLICATED | MERGED | LAST_WRITE_WINS_DRAFT | MANUAL_RESOLUTION | CORRECTION_WORKFLOW
  resolutionNote  String?
  resolvedAtUtc   DateTime?
  resolvedById   String?
  createdAtUtc    DateTime @default(now())

  @@index([deviceId])
  @@index([status, assignedToId])
  @@index([aggregateType, aggregateId])
  @@index([createdAtUtc])
}

model IdempotencyRecord {
  // Clé d'idempotence par utilisateur (cf. §14.2.6).
  // Permet de rejeter proprement les commandes répétées avec payload différent,
  // et de renvoyer le même résultat pour une commande répétée identique.
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  key             String   // UUID fourni par le client (header Idempotency-Key)
  payloadHash     String   // empreinte du payload
  resultJson      String?  // résultat mis en cache
  resultStatus    Int?     // code HTTP renvoyé
  expiresAtUtc    DateTime
  createdAtUtc    DateTime @default(now())

  @@unique([userId, key])
  @@index([userId])
  @@index([expiresAtUtc])
}

// ============================================================
// MODULES COMPLÉMENTAIRES (Cycle 06)
// Bibliothèque, transport, cantine, calendrier institutionnel
// ============================================================

model Book {
