  @@index([schoolId, status])
}

// ============================================================
// ÉTAPE 4 RDC — PORTAIL PROF COMPLET : IQA, ÉMARGEMENTS, CAHIER DE TEXTES, INCIDENTS
// Extension modulaire — Aucune régression sur les modèles précédents
// Conforme au cahier des charges §14.2.14-J + extension IQA RDC
// ============================================================

// A. AGENDA DES PROFESSEURS — Planning détaillé d'une séance
// Permet de matérialiser chaque séance planifiée avec un statut évolutif
model TeacherAgenda {
  id              String   @id @default(cuid())
  schoolId        String
  school          School   @relation(fields: [schoolId], references: [id])
  teacherId       String
  teacher         Employee @relation(fields: [teacherId], references: [id])
  classroomId     String
  classroom       Classroom @relation(fields: [classroomId], references: [id])
  subjectId       String?
  subject         Subject? @relation(fields: [subjectId], references: [id])
  courseId        String?
  course          Course?  @relation(fields: [courseId], references: [id])
  startDateTime   DateTime
  endDateTime     DateTime
  room            String?
  status          String   @default("PLANIFIED") // PLANIFIED | DONE | CANCELLED | IN_PROGRESS
  cancelledReason String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  emargements     TeacherEmargement[]
  lessonLogs      LessonLog[]
  incidents      ClassIncident[]

  @@index([schoolId, teacherId, startDateTime])
  @@index([schoolId, classroomId, startDateTime])
  @@index([schoolId, status])
}

// B. ÉMARGEMENT NUMÉRIQUE DU PROFESSEUR
// Généré dès que le prof ouvre sa session pour faire l'appel
// Déclenche une notification temps réel vers la Direction
model TeacherEmargement {
  id              String   @id @default(cuid())
  schoolId        String
  school          School   @relation(fields: [schoolId], references: [id])
  agendaId        String
  agenda          TeacherAgenda @relation(fields: [agendaId], references: [id], onDelete: Cascade)
  teacherId       String
  teacher         Employee @relation(fields: [teacherId], references: [id])
  classroomId     String
  classroom       Classroom @relation(fields: [classroomId], references: [id])
  subjectId       String?
  subject         Subject? @relation(fields: [subjectId], references: [id])
  signatureAt    DateTime @default(now()) // Horodatage de signature
  status          String   @default("PRESENT") // PRESENT | LATE
  ipAddress       String?  // IP machine (audit)
  userAgent       String?  // Navigateur/app (audit)
  directorNotifiedAt DateTime? // Confirme la notification envoyée au directeur
  createdAt       DateTime @default(now())

  studentAttendances StudentAttendanceCall[]
  lessonLog       LessonLog?

  @@unique([agendaId]) // Un émargement par séance
  @@index([schoolId, teacherId, signatureAt])
  @@index([schoolId, classroomId, signatureAt])
}

// C. APPEL DES ÉLÈVES — Saisie fine par statut
// Lié à un émargement prof — chaque élève appelé dans la séance
model StudentAttendanceCall {
  id              String   @id @default(cuid())
  schoolId        String
  school          School   @relation(fields: [schoolId], references: [id])
  emargementId    String
  emargement      TeacherEmargement @relation(fields: [emargementId], references: [id], onDelete: Cascade)
  studentId       String
  student         Student  @relation(fields: [studentId], references: [id])
  subjectId       String?
  subject         Subject? @relation(fields: [subjectId], references: [id])
  status          String   // PRESENT | ABSENT | LATE | EXCUSED
  lateMinutes     Int      @default(0) // Minutes de retard (si LATE)
  justified       Boolean  @default(false) // Si absence excusée
  justification   String?
  recordedAt      DateTime @default(now())
  recordedById    String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([emargementId, studentId]) // Anti-doublon : un élève = une ligne par séance
  @@index([schoolId, studentId])
  @@index([schoolId, status])
}

// D. CAHIER DE TEXTES ENRICHI — Lié à un émargement
// Le prof saisit le contenu pédagogique après le cours
model LessonLog {
  id              String   @id @default(cuid())
  schoolId        String
  school          School   @relation(fields: [schoolId], references: [id])
  emargementId    String   @unique
  emargement      TeacherEmargement @relation(fields: [emargementId], references: [id], onDelete: Cascade)
  agendaId        String
  agenda          TeacherAgenda @relation(fields: [agendaId], references: [id])
  teacherId       String
  teacher         Employee @relation(fields: [teacherId], references: [id])
  classroomId     String
  classroom       Classroom @relation(fields: [classroomId], references: [id])
  subjectId       String?
  subject         Subject? @relation(fields: [subjectId], references: [id])
  sessionDate     DateTime
  lessonTitle     String   // Titre de la leçon dispensée
  summary         String   // Résumé du cours (contenu pédagogique)
  homeworkPublished String? // Devoirs publiés
  resourcesUrl    String?  // Liens PowerPoint/PDF (JSON array string)
  status          String   @default("DRAFT") // DRAFT | PUBLISHED | AUDITED
  auditedAt       DateTime?
  auditedById     String?
  auditComment    String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([schoolId, teacherId, sessionDate])
  @@index([schoolId, classroomId, sessionDate])
  @@index([schoolId, subjectId])
  @@index([schoolId, status])
}

// E. INCIDENTS DE CLASSE — Signalés par le prof
// Avec support Offline Queue (synchro au retour réseau)
model ClassIncident {
  id              String   @id @default(cuid())
  schoolId        String
  school          School   @relation(fields: [schoolId], references: [id])
  agendaId        String?
  agenda          TeacherAgenda? @relation(fields: [agendaId], references: [id])
  teacherId       String
  teacher         Employee @relation(fields: [teacherId], references: [id])
  classroomId     String
  classroom       Classroom @relation(fields: [classroomId], references: [id])
  studentId       String?
  student         Student? @relation(fields: [studentId], references: [id])
  severity        String   @default("MEDIUM") // LOW | MEDIUM | HIGH | CRITICAL
  category        String   @default("OTHER") // DISCIPLINE | MATERIAL | ABSENCE | BEHAVIOR | SAFETY | OTHER
  description     String
  status          String   @default("OPEN") // OPEN | IN_PROGRESS | RESOLVED | ARCHIVED
  resolvedAt      DateTime?
  resolvedById    String?
  resolvedBy      Employee? @relation("IncidentResolver", fields: [resolvedById], references: [id])
  resolution      String?
  directorNotifiedAt DateTime?
  // Champs pour Offline Queue
  clientUUID      String   @unique // UUID généré côté client (offline) — idempotence
  syncStatus      String   @default("SYNCED") // PENDING | SYNCED | FAILED
  syncedAt        DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([schoolId, status])
  @@index([schoolId, severity])
  @@index([teacherId, createdAt])
  @@index([schoolId, classroomId])
}

// F. SNAPSHOT IQA — Calcul persisté pour éviter de surcharger le runtime
// Régénéré périodiquement (cron ou trigger) ou à la demande
model IqaSnapshot {
  id              String   @id @default(cuid())
  schoolId        String
  school          School   @relation(fields: [schoolId], references: [id])
  studentId       String
  student         Student  @relation(fields: [studentId], references: [id])
  subjectId       String?  // Null = IQA Global, non-null = IQA par matière
  subject         Subject? @relation(fields: [subjectId], references: [id])
  classroomId     String?
  classroom       Classroom? @relation(fields: [classroomId], references: [id])
  period          String   // "2026-09" ou "2026-W38" ou "T1"
  iqaValue        Float    // 0-100
  level           String   // EXCELLENT | WARNING | CRITICAL
  totalSessions   Int      @default(0)
  absencesUnexcused Int    @default(0)
  absencesExcused Int      @default(0)
  lateCount       Int      @default(0)
  computedAt      DateTime @default(now())
  createdAt       DateTime @default(now())

  @@unique([studentId, subjectId, period])
  @@index([schoolId, period])
  @@index([studentId])
  @@index([schoolId, level])
}

// ============================================================
// ÉTAPE 5 RDC — MODULE COMPTABLE SÉCURISÉ (ERP Multi-Section)
// ============================================================
// Architecture :
//   - StudentDebt : dette élève générée automatiquement à l'inscription
//   - Receipt : reçu infalsifiable (QR code + numérotation chronologique)
//   - MobileMoneyPayment : paiements Mobile Money (M-Pesa, Orange, MTN, Wave, Airtel)
//   - Scholarship : bourses & réductions (ex: -50% enfants du personnel)
//   - AccountingPeriod : clôture périodique (mensuelle/trimestrielle)
//   - Expense : dépenses (factures fournisseurs, achats)
//
// Règle d'or : jamais de paiement lié directement à Student.
//   Toujours via Inscription (Enrollment) + StudentDebt + Receipt.

// A. DETTE ÉLÈVE — générée automatiquement à l'inscription
// Represente ce que l'élève doit pour une ligne de frais donnée
model StudentDebt {
  id                  String   @id @default(cuid())
  schoolId            String
  school              School   @relation(fields: [schoolId], references: [id])
  studentId           String
  student             Student  @relation(fields: [studentId], references: [id])
  enrollmentId        String   // Lien vers l'inscription (multi-section)
  enrollment          Enrollment @relation(fields: [enrollmentId], references: [id])
  invoiceLineConfigId String   // Lien vers la configuration de frais
  invoiceLineConfig   InvoiceLineConfig @relation(fields: [invoiceLineConfigId], references: [id])
  directorateId       String?  // Pour cloisonnement multi-direction
  directorate         Directorate? @relation(fields: [directorateId], references: [id])
  classroomId         String?
  classroom           Classroom? @relation(fields: [classroomId], references: [id])
  academicYearId      String
  academicYear        AcademicYear @relation(fields: [academicYearId], references: [id])
  // Montants en centimes (précision BigInt native)
  amountDueCents      Int      // Montant dû initial
  amountPaidCents     Int      @default(0) // Montant déjà payé (cache, recalculé)
  amountCancelledCents Int     @default(0) // Avoirs/annulations
  currency            String   @default("CDF")
  period              String?  // T1, T2, T3, EXAM, MENSUEL-2026-09
  status              String   @default("OPEN") // OPEN | PARTIALLY_PAID | PAID | CANCELLED
  // Réduction (si bourse appliquée)
  scholarshipId       String?
  scholarship         Scholarship? @relation(fields: [scholarshipId], references: [id])
  reductionPercent    Int      @default(0) // 0-100
  reductionAmountCents Int     @default(0) // Montant de la réduction en centimes
  // Audit
  generatedAt         DateTime @default(now()) // Auto à l'inscription
  generatedById       String?
  lastPaymentAt       DateTime?
  closedAt            DateTime? // Quand status = PAID
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  receipts        Receipt[]

  @@unique([enrollmentId, invoiceLineConfigId, period])
  @@index([schoolId, status])
  @@index([studentId, status])
  @@index([directorateId, status])
  @@index([academicYearId])
  @@index([period])
}

// B. REÇU INFALSIFIABLE — numérotation chronologique + QR code
// Jamais supprimable. Annulation uniquement via avoir tracé.
model Receipt {
  id                  String   @id @default(cuid())
  schoolId            String
  school              School   @relation(fields: [schoolId], references: [id])
  receiptNumber       String   @unique // Numéro chronologique strict (ex: REC-2026-000001)
  receiptType         String   @default("PAYMENT") // PAYMENT | CREDIT_NOTE (avoir)
  // Liens
  studentDebtId       String?  // Lien vers la dette (peut être null pour paiement global)
  studentDebt         StudentDebt? @relation(fields: [studentDebtId], references: [id])
  studentId           String
  student             Student  @relation(fields: [studentId], references: [id])
  enrollmentId        String?
  // Montants
  amountCents         Int      // Montant encaissé
  currency            String   @default("CDF")
  // Moyen de paiement
  paymentMethod       String   // CASH | BANK | MOBILE_MONEY | CARD
  paymentProvider     String?  // MPESA | ORANGE | MTN | WAVE | AIRTEL (si Mobile Money)
  transactionReference String?  // Référence transaction Mobile Money / banque
  payerName           String?  // Nom du payeur (parent, tuteur)
  payerPhone          String?  // Téléphone du payeur (pour reçu Mobile Money)
  // Sécurité
  qrCodeData          String   // Données encodées dans le QR code
  signature           String   // Signature HMAC du reçu (anti-falsification)
  // Comptable émetteur
  accountantId        String   // ID du comptable qui a encaissé
  accountant          Employee @relation(fields: [accountantId], references: [id])
  accountantUserId    String?  // User ID pour audit
  // Annulation (avoir)
  cancelledById       String?  // ID du reçu d'avoir lié (si annulé)
  cancellationReason  String?
  cancelledAt         DateTime?
  cancelledByUserId   String?
  // Audit
  issuedAt            DateTime @default(now()) // Date d'émission
  printedCount        Int      @default(0) // Nombre d'impressions
  pdfUrl              String?  // URL du PDF généré
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  mobileMoneyPayment  MobileMoneyPayment?

  @@index([schoolId, issuedAt])
  @@index([schoolId, receiptNumber])
  @@index([studentId, issuedAt])
  @@index([paymentMethod, issuedAt])
  @@index([accountantId])
}

// C. PAIEMENT MOBILE MONEY — intégrations API (M-Pesa, Orange, MTN, Wave, Airtel)
model MobileMoneyPayment {
  id                  String   @id @default(cuid())
  schoolId            String
  school              School   @relation(fields: [schoolId], references: [id])
  receiptId           String   @unique // 1 reçu = 1 transaction Mobile Money
  receipt             Receipt  @relation(fields: [receiptId], references: [id])
  // Provider
  provider            String   // MPESA | ORANGE | MTN | WAVE | AIRTEL
  providerTransactionId String? // ID transaction côté provider
  // Payer
  payerPhoneNumber    String   // Numéro de téléphone du payeur
  payerName           String?
  // Montant
  amountCents         Int
  currency            String   @default("CDF")
  // Workflow
  status              String   @default("PENDING") // PENDING | SUCCESS | FAILED | REFUNDED
  providerStatus      String?  // Statut brut retourné par le provider
  errorMessage         String?
  // API
  apiRequestPayload   String?  // JSON envoyé au provider
  apiResponsePayload  String?  // JSON reçu du provider
  // Timestamps
  initiatedAt         DateTime @default(now())
  confirmedAt         DateTime?
  failedAt            DateTime?
  refundedAt          DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([schoolId, status])
  @@index([provider, status])
  @@index([payerPhoneNumber])
}

// D. BOURSE / RÉDUCTION
model Scholarship {
  id                  String   @id @default(cuid())
  schoolId            String
  school              School   @relation(fields: [schoolId], references: [id])
  name                String   // "Bourse enfant personnel", "Réduction orphelin"
  code                String   // "PERS-50", "ORPH-30"
  description         String?
  reductionPercent    Int      // 0-100 (ex: 50 = -50%)
  // Conditions d'éligibilité
  appliesToDirectorate String? // Null = toutes, sinon ID direction
  appliesToCategory    String?  // ALL | ORPHAN | STAFF_CHILD | NEEDY
  status              String   @default("ACTIVE") // ACTIVE | ARCHIVED
  // Audit
  createdById         String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  studentDebts        StudentDebt[]

  @@unique([schoolId, code])
  @@index([schoolId, status])
}

// E. CLÔTURE COMPTABLE — période mensuelle/trimestrielle
model AccountingPeriod {
  id                  String   @id @default(cuid())
  schoolId            String
  school              School   @relation(fields: [schoolId], references: [id])
  directorateId       String?  // Null = clôture globale, sinon par direction
  directorate         Directorate? @relation(fields: [directorateId], references: [id])
  periodType          String   // MONTH | QUARTER | YEAR
  periodLabel         String   // "2026-09" ou "T1-2026" ou "2026-2027"
  startDate           DateTime
  endDate             DateTime
  // Totaux en centimes
  totalCollectedCents Int      @default(0)
  totalCancelledCents Int      @default(0)
  totalExpensesCents  Int      @default(0)
  netBalanceCents     Int      @default(0)
  currency            String   @default("CDF")
  // Statut
  status              String   @default("OPEN") // OPEN | CLOSED | LOCKED
  closedAt            DateTime?
  closedById          String?
  closedByName        String?
  // Audit
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@unique([schoolId, directorateId, periodType, periodLabel])
  @@index([schoolId, status])
}

// F. DÉPENSES (factures fournisseurs, achats, paie)
model Expense {
  id                  String   @id @default(cuid())
  schoolId            String
  school              School   @relation(fields: [schoolId], references: [id])
  directorateId       String?  // Null = dépense globale
  directorate         Directorate? @relation(fields: [directorateId], references: [id])
  expenseNumber       String   @unique // DEP-2026-000001
  // Catégorie
  category            String   // SUPPLIES | MAINTENANCE | SALARY | UTILITIES | RENT | OTHER
  description         String
  supplierName        String?  // Nom du fournisseur
  supplierInvoice     String?  // Numéro facture fournisseur
  // Montant
  amountCents         Int
  currency            String   @default("CDF")
  paymentMethod       String   @default("CASH") // CASH | BANK | MOBILE_MONEY
  // Période
  expenseDate         DateTime
  accountingPeriodId  String?  // Lien vers clôture comptable
  // Workflow validation
  status              String   @default("PENDING") // PENDING | APPROVED | PAID | REJECTED
  requestedById       String?  // Demandeur (Direction)
  requestedByName     String?
  approvedById        String?  // Validateur (Promoteur)
  approvedByName      String?
  approvedAt          DateTime?
  rejectionReason     String?
  // Audit
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([schoolId, status])
  @@index([schoolId, category])
  @@index([directorateId, status])
  @@index([expenseDate])
}

// ============================================================
// ÉTAPE 6 RDC — MODULES CONTENU & COMMUNICATION
// ============================================================
//   - Article : articles/news filtrés par rôle (élève, parent, enseignant)
//   - Contact : annuaire des contacts utiles
//   - SlideshowImage : diaporama pour page d'accueil
//   - Reception : gestion des visiteurs / rendez-vous

// G. ARTICLES — filtrés par rôle cible
model Article {
  id              String   @id @default(cuid())
  schoolId        String
  school          School   @relation(fields: [schoolId], references: [id])
  title           String
  slug            String
  excerpt         String?  // résumé court
  content         String   // contenu complet (HTML ou Markdown)
  category        String   @default("GENERAL") // NEWS | EVENT | ANNOUNCEMENT | GENERAL
  // Filtrage par rôle cible
  targetRoles     String   @default("ALL") // ALL | STUDENT | PARENT | TEACHER | DIRECTION (séparés par virgules)
  targetClassroomIds String? // Null = toutes classes, sinon liste d'IDs séparés par virgules
  // Média
  imageUrl        String?
  imageAlt        String?
  // Publication
  status          String   @default("DRAFT") // DRAFT | PUBLISHED | ARCHIVED
  publishedAt     DateTime?
  pinned          Boolean  @default(false) // article épinglé en haut
  // Ordre d'affichage
  sortOrder       Int      @default(0)
  // Audit
  createdById     String?
  createdByName   String?
  updatedById     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([schoolId, slug])
  @@index([schoolId, status, publishedAt])
  @@index([schoolId, category])
}

// H. CONTACTS — annuaire
model Contact {
  id              String   @id @default(cuid())
  schoolId        String
  school          School   @relation(fields: [schoolId], references: [id])
  // Catégorie
  category        String   @default("STAFF") // STAFF | EMERGENCY | PARTNER | SUPPLIER | OTHER
  // Identité
  firstName       String?
  lastName        String
  function        String?  // fonction / poste
  organization    String?  // organisation / entreprise
  // Coordonnées
  email           String?
  phone           String?
  mobilePhone     String?
  address         String?
  // Visibilité
  isPublic        Boolean  @default(true) // visible dans l'annuaire public
  sortOrder       Int      @default(0)
  // Audit
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([schoolId, category])
  @@index([schoolId, isPublic])
}

// I. SLIDESHOW — diaporama page d'accueil
model SlideshowImage {
  id              String   @id @default(cuid())
  schoolId        String
  school          School   @relation(fields: [schoolId], references: [id])
  title           String?
  description     String?
  imageUrl        String   // URL de l'image
  linkUrl         String?  // lien optionnel au clic
  // Ordre d'affichage
  sortOrder       Int      @default(0)
  // Affichage
  status          String   @default("ACTIVE") // ACTIVE | HIDDEN
  // Audit
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([schoolId, status, sortOrder])
}

// J. RECEPTIONS — gestion des visiteurs / rendez-vous
model Reception {
  id              String   @id @default(cuid())
  schoolId        String
  school          School   @relation(fields: [schoolId], references: [id])
  // Visiteur
  visitorName     String
  visitorPhone    String?
  visitorEmail    String?
  visitorOrganization String?
  // Motif
  purpose         String   // INTERVIEW | MEETING | DELIVERY | PARENT_MEETING | OTHER
  purposeDetail    String?
  // Cible (personne visitée)
  targetPersonName String?
  targetPersonId   String? // Employee ID si interne
  // Planification
  scheduledDate   DateTime
  scheduledEndTime DateTime?
  checkInTime     DateTime? // arrivée réelle
  checkOutTime    DateTime? // départ réel
  // Statut
  status          String   @default("SCHEDULED") // SCHEDULED | CHECKED_IN | CHECKED_OUT | CANCELLED | NO_SHOW
  // Notes
  notes           String?
  // Audit
  createdById     String?
  createdByName   String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([schoolId, scheduledDate])
  @@index([schoolId, status])
}

// ============================================================
// ÉTAPE 7 — SYSTÈME DE LICENCES & PROTECTION
// ============================================================
//   - License : licence d'utilisation par école (période + modules)
//   - ActivationCode : code d'activation unique généré par le promoteur
//   - LicenseAudit : journal des activations/vérifications

// K. LICENCE — une par école
model License {
  id              String   @id @default(cuid())
  schoolId        String?  @unique // Lié à l'école après activation (null avant)
  school          School?  @relation(fields: [schoolId], references: [id])
  // Clé de licence
  licenseKey      String   @unique // Format: XXXX-XXXX-XXXX-XXXX-XXXX
  // École cliente
  clientName      String   // Nom de l'école cliente
  clientEmail     String   // Email de contact
  clientPhone     String?  // Téléphone
  clientCity      String?  // Ville
  clientCountry   String   @default("RDC")
  // Période
  planType        String   @default("ANNUAL") // MONTHLY | QUARTERLY | ANNUAL | LIFETIME
  maxStudents     Int      @default(500) // Limite d'élèves
  maxDirections   Int      @default(3) // Limite de directions
  // Modules autorisés
  modules         String   @default("ALL") // ALL ou liste: ADMIN,PEDAGOGY,FINANCE,PARENT_PORTAL
  // Dates
  issuedAt        DateTime @default(now())
  activatedAt     DateTime? // Date d'activation (premier usage)
  expiresAt      DateTime? // Date d'expiration (null = à vie)
  // Statut
  status          String   @default("PENDING") // PENDING | ACTIVE | SUSPENDED | EXPIRED | REVOKED
  // Machine liée (anti-piratage)
  machineId       String?  // ID unique de la machine activée
  machineName     String?  // Nom de l'ordinateur
  activationCount Int      @default(0) // Nombre de tentatives d'activation
  maxActivations  Int      @default(1) // 1 = une seule machine
  // Audit
  createdById     String?  // Promoteur qui a créé la licence
  createdByName   String?
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  activations     ActivationCode[]
  audits          LicenseAudit[]

  @@index([status])
  @@index([clientEmail])
}

// L. CODE D'ACTIVATION — généré par le promoteur
model ActivationCode {
  id              String   @id @default(cuid())
  licenseId       String
  license         License  @relation(fields: [licenseId], references: [id], onDelete: Cascade)
  // Code unique
  code            String   @unique // Format: AC-XXXXXX-XXXXXX-XXXXXX (18 chars)
  // Type
  codeType        String   @default("ACTIVATION") // ACTIVATION | RENEWAL | UPGRADE
  // Usage
  isUsed          Boolean  @default(false)
  usedAt          DateTime?
  usedByMachine   String?  // Machine ID qui a utilisé le code
  // Expiration du code lui-même
  expiresAt       DateTime? // Le code expire s'il n'est pas utilisé
  // Audit
  createdAt       DateTime @default(now())

  @@index([licenseId])
  @@index([isUsed])
}

// M. AUDIT DE LICENCE — journal des vérifications
model LicenseAudit {
  id              String   @id @default(cuid())
  licenseId       String
  license         License  @relation(fields: [licenseId], references: [id], onDelete: Cascade)
  // Action
  action          String   // ACTIVATED | VERIFIED | EXPIRED | SUSPENDED | REVOKED | RENEWED
  // Machine
  machineId       String?
  machineName     String?
  ipAddress       String?
  // Détails
  details         String?
  success         Boolean  @default(true)
  createdAt       DateTime @default(now())

  @@index([licenseId])
  @@index([action])
}

// ============================================================
// ÉTAPE 8 — SÉCURITÉ PARENTS & PRÉINSCRIPTION
// ============================================================
//   - PreRegistration : dossier de préinscription d'un nouvel élève
//   - ParentLinkRequest : demande de rattachement à un élève existant

// N. PRÉINSCRIPTION — dossier d'admission d'un nouvel élève
model PreRegistration {
  id              String   @id @default(cuid())
  schoolId        String
  school          School   @relation(fields: [schoolId], references: [id])
  // Demandeur (parent qui crée le compte)
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Numéro de dossier unique
  referenceNumber String   @unique // Format: PRE-2026-000001
  // Informations du parent
  parentFirstName String
  parentLastName  String
  parentEmail     String
  parentPhone     String
  parentRelationship String @default("PERE") // PERE | MERE | TUTEUR | AUTRE
  // Informations de l'enfant
  childFirstName  String
  childLastName   String
  childBirthDate  DateTime?
  childGender     String?  // M | F
  // Souhaits
  desiredClassroomId String? // Classe souhaitée
  desiredLevel    String?  // Niveau souhaité
  academicYearLabel String? // Année souhaitée
  // Contacts d'urgence
  emergencyContactName String?
  emergencyContactPhone String?
  address         String?
  // Documents (URLs)
  birthCertificateUrl String?
  photoUrl        String?
  reportCardUrl   String?
  vaccinationUrl  String?
  // Consentements
  acceptedTerms   Boolean  @default(false)
  acceptedPrivacy Boolean  @default(false)
  // Moyen de contact préféré
  preferredContact String  @default("WHATSAPP") // EMAIL | WHATSAPP | SMS | CALL
  // Statut du dossier
  status          String   @default("DRAFT") // DRAFT | SOUMIS | INCOMPLET | EN_ETUDE | ACCEPTE | REFUSE | TRANSFERE_DIRECTION
  // Traitement
  reviewedById    String?  // ID du secrétaire/directeur
  reviewedByName  String?
  reviewedAt      DateTime?
  decisionReason  String?
  // Élève créé après acceptation
  studentId       String?  // Lien vers l'élève créé
  // Audit
  submittedAt    DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  history        PreRegistrationHistory[]

  @@index([schoolId, status])
  @@index([userId])
  @@index([referenceNumber])
}

// Historique des actions sur un dossier de préinscription
model PreRegistrationHistory {
  id              String   @id @default(cuid())
  preRegistrationId String
  preRegistration PreRegistration @relation(fields: [preRegistrationId], references: [id], onDelete: Cascade)
  action          String   // CREATED | SUBMITTED | MARKED_INCOMPLETE | REVIEWED | ACCEPTED | REFUSED | TRANSMITTED
  performedById   String?
  performedByName String?
  notes           String?
  previousStatus  String?
  newStatus       String?
  createdAt       DateTime @default(now())

  @@index([preRegistrationId])
}

// O. DEMANDE DE RATTACHEMENT — parent demandant à être lié à un élève existant
model ParentLinkRequest {
  id              String   @id @default(cuid())
  schoolId        String
  school          School   @relation(fields: [schoolId], references: [id])
  // Demandeur
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Élève ciblé
  studentId       String
  student         Student  @relation(fields: [studentId], references: [id])
  // Informations fournies par le demandeur
  parentFirstName String
  parentLastName  String
  parentPhone     String
  relationship    String   // PERE | MERE | TUTEUR | AUTRE
  // Vérification
  childBirthDateProvided DateTime?
  verificationCode String?  // Code remis par l'école (optionnel)
  // Statut
  status          String   @default("EN_ATTENTE") // EN_ATTENTE | ACCEPTE | REFUSE | COMPLEMENT_DEMANDE
  reviewedById    String?
  reviewedByName  String?
  reviewedAt      DateTime?
  decisionReason  String?
  // Audit
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([schoolId, status])
  @@index([userId])
  @@index([studentId])
}

// ============================================================
// ÉTAPE 9 — MODULE ADMISSIONS V2 (multi-enfants + anti-doublon)
// ============================================================
// Architecture :
//   AdmissionApplication : demande globale d'un parent (peut contenir N enfants)
//   ChildApplication : sous-dossier par enfant dans la demande
//   AdmissionDocument : documents uploadés par enfant

// P. DEMANDE D'ADMISSION GLOBALE (1 parent → N enfants)
model AdmissionApplication {
  id              String   @id @default(cuid())
  schoolId        String
  school          School   @relation(fields: [schoolId], references: [id])
  // Demandeur
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Référence unique
  referenceNumber String   @unique // Format: ADM-2026-000001
  // Type
  applicationType String   @default("NEW_ADMISSION") // NEW_ADMISSION | LINK_EXISTING
  // Statut global
  status          String   @default("DRAFT") // DRAFT | SUBMITTED | INCOMPLETE | TO_VERIFY | DUPLICATE_SUSPECTED | TRANSMITTED | ACCEPTED | REFUSED | ARCHIVED | CANCELLED
  // Informations parent (dénormalisé pour recherche rapide)
  parentFirstName String
  parentLastName  String
  parentEmail     String
  parentPhone     String
  parentRelationship String @default("PERE")
  // Vérifications
  emailVerified   Boolean  @default(false)
  phoneVerified   Boolean  @default(false)
  // Traitement
  reviewedById    String?
  reviewedByName  String?
  reviewedAt      DateTime?
  decisionReason  String?
  // Audit
  submittedAt    DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  children        ChildApplication[]
  documents       AdmissionDocument[]
  history         AdmissionHistory[]

  @@index([schoolId, status])
  @@index([userId])
  @@index([referenceNumber])
  @@index([parentEmail])
  @@index([parentPhone])
}

// Q. SOUS-DOSSIER PAR ENFANT (dans une demande globale)
model ChildApplication {
  id              String   @id @default(cuid())
  applicationId   String
  application     AdmissionApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  // Infos enfant
  childFirstName  String
  childLastName   String
  childBirthDate  DateTime?
  childGender     String?  // M | F
  childBirthPlace String?
  previousSchool  String?
  // Souhaits
  desiredLevel    String?
  desiredClassroomId String? // Doit venir des classes existantes
  // Statut individuel (peut différer du statut global)
  status          String   @default("PENDING") // PENDING | INCOMPLETE | ACCEPTED | REFUSED | DUPLICATE
  // Doublon détecté
  duplicateStatus String?  // null | SUSPECTED | CONFIRMED | DISTINCT
  duplicateStudentId String? // Si doublon confirmé → lien vers l'élève existant
  // Élève créé après acceptation
  studentId       String?
  matricule       String?
  // Traitement
  reviewedAt      DateTime?
  decisionReason  String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  documents       AdmissionDocument[]
  history         AdmissionHistory[]

  @@index([applicationId])
  @@index([status])
  @@index([studentId])
}

// R. DOCUMENTS D'ADMISSION (par enfant ou global)
model AdmissionDocument {
  id              String   @id @default(cuid())
  applicationId   String
  application     AdmissionApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  childApplicationId String? // Null = document global du parent, non-null = spécifique à un enfant
  childApplication ChildApplication? @relation(fields: [childApplicationId], references: [id], onDelete: Cascade)
  // Type
  documentType    String   // BIRTH_CERTIFICATE | PHOTO | REPORT_CARD | VACCINATION | ID_PROOF | PROOF_OF_ADDRESS | OTHER
  // Fichier
  fileName        String
  fileUrl         String   // URL de stockage (Supabase Storage ou local)
  fileSize        Int      // En bytes
  mimeType        String   // application/pdf, image/jpeg, etc.
  // Vérification
  verified        Boolean  @default(false)
  verifiedById    String?
  verifiedAt      DateTime?
  // Audit
  createdAt       DateTime @default(now())

  @@index([applicationId])
  @@index([childApplicationId])
  @@index([documentType])
}

// S. HISTORIQUE DES DÉCISIONS D'ADMISSION
model AdmissionHistory {
  id              String   @id @default(cuid())
  applicationId   String
  application     AdmissionApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  childApplicationId String?
  childApplication ChildApplication? @relation(fields: [childApplicationId], references: [id], onDelete: Cascade)
  // Action
  action          String   // CREATED | SUBMITTED | MARKED_INCOMPLETE | DUPLICATE_DETECTED | TRANSMITTED | ACCEPTED | REFUSED | ARCHIVED | CANCELLED | DOCUMENT_UPLOADED | DOCUMENT_VERIFIED
  performedById   String?
  performedByName String?
  notes           String?
  previousStatus  String?
  newStatus       String?
  createdAt       DateTime @default(now())

  @@index([applicationId])
  @@index([childApplicationId])
  @@index([action])
}

// T. FILE D'ATTENTE ADMINISTRATIVE (Secrétariat)
model AdminTask {
  id              String   @id @default(cuid())
  schoolId        String
  school          School   @relation(fields: [schoolId], references: [id])
  // Relations (optionnelles)
  studentId       String?
  student         Student? @relation(fields: [studentId], references: [id])
  admissionApplicationId String?
  // Détails
  title           String
  description     String?
  category        String   // ADMISSION | ENROLLMENT | ABSENCE | DOCUMENT | COMMUNICATION | TRANSFER | OTHER
  priority        String   @default("NORMAL") // CRITICAL | URGENT | NORMAL | LOW
  status          String   @default("PENDING") // PENDING | IN_PROGRESS | WAITING_PARENT | WAITING_DIRECTION | WAITING_SERVICE | DONE | CANCELLED
  // Échéance
  dueDate         DateTime?
  // Assignation
  assignedToId    String?  // User ID de la secrétaire assignée
  assignedToName  String?
  // Création
  createdById     String?
  createdByName   String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  completedAt     DateTime?

  @@index([schoolId, status, priority])
  @@index([schoolId, category])
  @@index([studentId])
  @@index([dueDate])
}
