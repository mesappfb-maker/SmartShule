  schoolId        String
  school          School   @relation(fields: [schoolId], references: [id])
  isbn            String?
  title           String
  author          String?
  category        String?
  numberOfCopies Int      @default(1)
  availableCopies Int     @default(1)
  status          String   @default("ACTIVE") // ACTIVE | ARCHIVED
