# SmartShule — Variables d'environnement
# ============================================================
# Copiez ce fichier vers .env et remplissez les valeurs.
# Pour la production Vercel, configurez ces variables dans :
#   Vercel → Project Settings → Environment Variables

# ============================================================
# BASE DE DONNÉES
# ============================================================

# Développement local (SQLite)
DATABASE_URL=file:./db/custom.db

# Production (Supabase PostgreSQL)
# Décommentez et remplacez par votre URL Supabase :
# DATABASE_URL=postgresql://postgres.REF:PASSWORD@aws-REGION.pooler.supabase.com:5432/postgres

# ============================================================
# SUPABASE (optionnel — pour auth, storage, RLS)
# ============================================================
# NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY
# SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# ============================================================
# AUTH & SÉCURITÉ
# ============================================================
# Secret pour les sessions (générez une chaîne aléatoire de 32+ caractères)
SESSION_SECRET=change-this-to-a-random-32-char-string

# Chiffrement des credentials (Twilio, etc.)
CREDENTIALS_ENC_KEY=smartshule-default-enc-key-change-in-production-32bytes

# ============================================================
# GOOGLE OAUTH (Phase 6)
# ============================================================
# GOOGLE_CLIENT_ID=YOUR-GOOGLE-CLIENT-ID
# GOOGLE_CLIENT_SECRET=YOUR-GOOGLE-CLIENT-SECRET
# NEXTAUTH_URL=https://smart-shule-seven.vercel.app

# ============================================================
# TWILIO (SMS / WhatsApp)
# ============================================================
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=YOUR-TWILIO-AUTH-TOKEN
# TWILIO_FROM_SMS=+1234567890
# TWILIO_FROM_WHATSAPP=whatsapp:+1234567890

# ============================================================
# STORAGE (documents PDF, sauvegardes)
# ============================================================
# Local : dossier de stockage
STORAGE_ROOT=/home/z/my-project/storage

# Production : Supabase Storage (buckets 'documents' et 'backups')
# STORAGE_PROVIDER=supabase

# ============================================================
# CRON (tâches programmées)
# ============================================================
# Clé pour protéger les endpoints cron
CRON_API_KEY=change-this-to-a-random-string

# ============================================================
# SEED DÉMO
# ============================================================
# Mot de passe par défaut pour les comptes démo
DEMO_PASSWORD=Demo2026!

# Protéger l'API de seed (optionnel)
# SEED_SECRET=your-secret-here

# ============================================================
# NODE_ENV
# ============================================================
# production = pas de données démo, pas de fallback school_id
# development = données démo autorisées, fallback school_id
NODE_ENV=development
