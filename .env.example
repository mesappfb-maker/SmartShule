# SmartShule — Variables d'environnement (exemple)
# ============================================================
# Copiez ce fichier vers .env et adaptez les valeurs.
# NE COMMITEZ JAMAIS le fichier .env (il est dans .gitignore).

# Base de données SQLite
# En développement local :
DATABASE_URL=file:./db/custom.db
# En production (Render avec disque persistant) :
# DATABASE_URL=file:/data/custom.db

# Secret pour les sessions (générez avec : openssl rand -base64 32)
NEXTAUTH_SECRET=change-me-in-production

# URL publique de l'API (pour le Portail Parent web)
NEXT_PUBLIC_API_URL=http://localhost:3000

# TTL d'idempotence des commandes (en heures)
IDEMPOTENCY_TTL_HOURS=24
